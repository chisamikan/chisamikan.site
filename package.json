{
  "name": "chisamikan.site",
  "version": "1.0.0",
  "description": "千紗みかんウェブサイト",
  "main": "index.js",
  "scripts": {
    "build:ejs": "node rss-parser.js && ejs-cli --base-dir src/ejs/pages '**/**.ejs' --out dist/temp --options site.json && html-minifier --input-dir dist/temp --output-dir dist -c html-minifier.json --file-ext html && rimraf 'dist/temp'",
    "build:js": "babel src/js --out-dir src/js/babel && uglifyjs 'src/js/babel/*.js' -o dist/bundle.js && rimraf src/js/babel",
    "build:imagemin": "node .imagemin.mjs && cpx \"src/images/favicon.ico\" dist/images",
    "build:icons": "mkdirp dist/icons && fantasticon src/icons -o dist/icons --normalize && rimraf dist/icons/icons.html dist/icons/icons.ts dist/icons/icons.json && postcss -r dist/icons/icons.css",
    "build:css": "postcss ./src/css/style.css -o ./dist/style.css",
    "build": "rimraf dist && run-s 'build:*'",
    "test": "browser-sync start --config bs-config.js",
    "start:css": "chokidar \"src/css/**.css\" -c \"yarn build:css\"",
    "start:ejs": "chokidar \"src/ejs/**/*.ejs\" \"-c yarn build:ejs && yarn build:css\"",
    "start:js": "chokidar \"src/js/*.js\" \"-c yarn build:js\"",
    "start:imagemin": "chokidar \"src/images\" \"-c yarn build:imagemin\"",
    "start": "run-s 'build:*' && run-p test 'start:*'"
  },
  "author": "Chisamikan",
  "license": "UNLICENSED",
  "private": true,
  "browserslist": [
    "> 0.5% in JP, not dead",
    "not IE 11"
  ],
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@jeffy-g/cpx": "^1.7.6",
    "@tailwindcss/postcss": "^4.2.2",
    "@twbs/fantasticon": "^3.1.0",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.10.11",
    "browser-sync": "^3.0.4",
    "chokidar-cli": "^3.0.0",
    "core-js": "3.49.0",
    "cssnano": "^7.1.3",
    "ejs-cli": "^2.2.3",
    "html-minifier": "^4.0.0",
    "imagemin": "^9.0.1",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^12.0.0",
    "mkdirp": "^3.0.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.8",
    "postcss-aspect-ratio-polyfill": "^2.0.0",
    "postcss-cli": "^11.0.1",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-import": "^16.1.1",
    "postcss-sort-media-queries": "^6.3.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.1.3",
    "rss-parser": "^3.13.0",
    "stylelint": "^17.6.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "uglify-js": "^3.19.3"
  },
  "dependencies": {
    "tailwindcss": "^3.4.19"
  },
  "packageManager": "yarn@4.10.3",
  "volta": {
    "node": "24.13.1",
    "yarn": "4.10.3"
  }
}
