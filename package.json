{
  "name": "chisamikan.site",
  "type": "module",
  "version": "2.0.0",
  "description": "千紗みかんウェブサイト",
  "author": "Chisamikan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-icons.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/build-icons.mjs",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "refresh-font-chars": "node -e \"require('node:fs').rmSync('scripts/font-base-chars.txt', { force: true })\" && npm run build",
    "cf-typegen": "wrangler types",
    "postinstall": "npm run cf-typegen"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@notionhq/client": "^5.31.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "subset-font": "^2.9.0",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260917.1": true
  }
}
