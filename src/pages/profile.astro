---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProfileContent from '../components/ProfileContent.astro';
import WorkItemComponent from '../components/WorkItem.astro';
import Lightbox from '../components/Lightbox.astro';
import { getFeedItems } from '../lib/rss';
import { getWorkHistory } from '../lib/notion';
import { supportLinks, zennFeedUrl } from '../lib/config';

const techDocs = await getFeedItems(zennFeedUrl, 3);
const works = await getWorkHistory();
const workTags = Array.from(new Set(works.flatMap((i) => i.tags))).sort();
---

<BaseLayout title="Profile" description="千紗みかんのプロフィールページです。">
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <SectionHeading eyebrow="Profile" title="プロフィール" level={1} />

    <div class="mx-auto max-w-2xl text-center">
      <ProfileContent />
    </div>

    <!-- 技術文書(Zennの記事フィード) -->
    <div class="mx-auto mt-16 max-w-2xl">
      <h2 class="profile-section-heading">技術文書</h2>
	  <p class="leading-relaxed text-ink/80">ZennでLLMに関する技術文書を投稿しています。</p>
      {techDocs.length > 0 ? (
        <ul class="mx-auto mt-6 divide-y divide-ink/10 text-left">
          {techDocs.map((item) => (
            <li class="py-4 first:pt-0 last:pb-0">
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="no-external-icon group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4"
              >
                {item.date && (
                  <span class="shrink-0 font-mono text-xs text-graphite">
                    {new Date(item.date).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                  </span>
                )}
                <span class="text-ink transition-colors group-hover:text-accent">
                  {item.title}
                  <i class="fa-solid fa-arrow-up-right-from-square ml-0.5 text-[0.8em]" aria-hidden="true"></i>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 font-mono text-sm text-graphite">記事はまだありません。</p>
      )}
    </div>
    <div class="mt-8 text-center">
      <a
        href="https://zenn.dev/chisamikan"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-glass btn-glass-accent md:w-1/3 w-full"
      >
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>技術文書をもっと見る
      </a>
    </div>

	<!-- 支援先 -->
    <div class="mx-auto mt-16 max-w-2xl">
      <h2 class="profile-section-heading">支援先</h2>
      <ul class="mx-auto mt-6 divide-y divide-ink/10 text-left">
        {supportLinks.map((link) => (
          <li class="py-4 first:pt-0 last:pb-0">
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="no-external-icon group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4"
            >
              <span class="flex shrink-0 items-center gap-2 text-ink transition-colors group-hover:text-accent">
                <i class:list={[link.icon]} aria-hidden="true"></i>
                {link.label}
                <i class="fa-solid fa-arrow-up-right-from-square text-[0.8em]" aria-hidden="true"></i>
              </span>
              <span class="text-sm text-graphite">{link.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- 仕事履歴 -->
    <div class="mx-auto mt-16 max-w-2xl">
      <h2 class="profile-section-heading">仕事履歴</h2>

      {workTags.length > 0 && (
        <div class="mb-4 flex flex-wrap gap-2" role="group" aria-label="タグで絞り込み">
          <button type="button" data-filter="all" class="filter-btn btn-glass-ghost is-active">
            すべて
          </button>
          {workTags.map((tag) => (
            <button type="button" data-filter={tag} class="filter-btn btn-glass-ghost">
              {tag}
            </button>
          ))}
        </div>
      )}

      {works.length > 0 ? (
        <div id="works-list">
          {works.map((item) => (
            <div class="card-reveal" data-tags={item.tags.join('|')}>
              <WorkItemComponent item={item} headingLevel={3} />
            </div>
          ))}
        </div>
      ) : (
        <p class="font-mono text-sm text-graphite">まだ実績が登録されていません。</p>
      )}

      <p id="works-empty" class="hidden font-mono text-sm text-graphite">
        該当するタグの実績がありません。
      </p>
    </div>
    <div class="mt-8 text-center">
      <a href="/contact" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-envelope pr-1"></i>ご依頼はこちら
      </a>
    </div>
    <div class="mt-8 text-center">
      <a href="/" class="btn-glass md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .profile-section-heading {
    @apply mb-4 border-l-4 border-accent pl-3 text-lg font-semibold text-ink;
  }

  .filter-btn.is-active {
    @apply border-accent/40 bg-accent/80 text-white shadow-glass-accent backdrop-blur-xl hover:bg-accent hover:text-white;
  }
</style>

<script>
  // タグボタンでの絞り込み(依存ライブラリなしのシンプルなvanilla JS)
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = Array.from(
    document.querySelectorAll<HTMLElement>('#works-list > [data-tags]')
  );
  const emptyMessage = document.querySelector<HTMLElement>('#works-empty');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const filter = btn.dataset.filter;

      let visibleCount = 0;
      items.forEach((item) => {
        const tags = (item.dataset.tags ?? '').split('|').filter(Boolean);
        const match = filter === 'all' || tags.includes(filter ?? '');
        item.style.display = match ? '' : 'none';
        if (match) visibleCount += 1;
      });

      if (emptyMessage) {
        emptyMessage.classList.toggle('hidden', visibleCount > 0);
      }
    });
  });
</script>
