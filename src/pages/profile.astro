---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProfileContent from '../components/ProfileContent.astro';
import List from '../components/List.astro';
import Lightbox from '../components/Lightbox.astro';
import TagFilter from '../components/TagFilter.astro';
import { getWorkHistory } from '../lib/notion';
import { supportLinks } from '../lib/config';

const works = await getWorkHistory();
const workTags = Array.from(new Set(works.flatMap((i) => i.tags))).sort();
---

<BaseLayout title="Profile" description="千紗みかんのプロフィールページです。">
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <SectionHeading eyebrow="Profile" title="プロフィール" level={1} />

    <div class="mx-auto max-w-2xl text-center">
      <ProfileContent />
    </div>

	<!-- 支援先 -->
    <div class="mx-auto mt-16 max-w-2xl">
      <h2 class="profile-section-heading">支援先</h2>
      <ul class="mx-auto mt-6 divide-y divide-ink/10 text-left">
        {supportLinks.map((link) => (
          <li class="py-4 first:pt-0 last:pb-0">
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="no-external-icon group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4"
            >
              <span class="flex shrink-0 items-center gap-2 text-ink transition-colors group-hover:text-accent">
                <i class:list={[link.icon]} aria-hidden="true"></i>
                {link.label}
                <i class="fa-solid fa-arrow-up-right-from-square text-[0.8em]" aria-hidden="true"></i>
              </span>
              <span class="text-sm text-graphite">{link.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- 仕事履歴 -->
    <div class="mx-auto mt-16 max-w-2xl">
      <h2 class="profile-section-heading">仕事履歴</h2>

      <TagFilter tags={workTags} containerSelector="#works-list" emptySelector="#works-empty" />

      {works.length > 0 ? (
        <div id="works-list">
          {works.map((item) => (
            <div class="card-reveal" data-tags={item.tags.join('|')}>
              <List type="work" item={item} headingLevel={3} />
            </div>
          ))}
        </div>
      ) : (
        <p class="font-mono text-sm text-graphite">まだ実績が登録されていません。</p>
      )}

      <p id="works-empty" class="hidden font-mono text-sm text-graphite">
        該当するタグの実績がありません。
      </p>
    </div>
    <div class="mt-8 text-center">
      <a href="/contact" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-envelope pr-1"></i>ご依頼はこちら
      </a>
    </div>
    <div class="mt-8 text-center">
      <a href="/" class="btn-glass md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  @reference '../styles/global.css';

  .profile-section-heading {
    @apply mb-4 border-l-4 border-accent pl-3 text-lg font-semibold text-ink;
  }
</style>
