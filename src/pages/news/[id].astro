---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getManualNewsItems } from '../../lib/notion';
import { getCategoryMeta } from '../../lib/news';
import { person } from '../../lib/config';

// Notionの手動投稿DBの記事ごとの個別ページ。一覧(/news/[...page])のページ番号とはIDの形式が異なるため衝突しない
export const getStaticPaths = (async () => {
  const items = await getManualNewsItems();
  return items.map((item) => ({ params: { id: item.id }, props: { item } }));
}) satisfies GetStaticPaths;

const { item } = Astro.props;
const meta = getCategoryMeta('manual');
const date = item.date ?? item.createdTime;
const formattedDate = new Date(date)
  .toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
  .replaceAll('/', '.');
const isExternal = Boolean(item.url?.startsWith('http'));

const breadcrumbs = [
  { name: 'ホーム', href: '/' },
  { name: 'お知らせ', href: '/news/' },
  { name: meta.label, href: `/news/category/${meta.value}/` },
];
// 画面では記事名を出さない(すぐ下のh1と重なるため)が、検索向けのデータには今のページとして含める。
// 記事名はNotionの入力のままなので、埋め込み時に < を逃がして </script> でタグが閉じないようにする
const siteURL = new URL('/', Astro.site ?? Astro.url).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        ...breadcrumbs.map((crumb, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: crumb.name,
          item: new URL(crumb.href, siteURL).toString(),
        })),
        { '@type': 'ListItem', position: breadcrumbs.length + 1, name: item.title },
      ],
    },
    // 書いた人はBaseLayoutの構造化データのPersonと@idで結ぶ。別のscriptにあるため名前とURLも書いておく
    {
      '@type': 'Article',
      headline: item.title,
      datePublished: date,
      inLanguage: 'ja',
      mainEntityOfPage: new URL(Astro.url.pathname, siteURL).toString(),
      author: { '@id': `${siteURL}#person`, '@type': 'Person', name: person.name, url: new URL('/profile/', siteURL).toString() },
      publisher: { '@id': `${siteURL}#person` },
    },
  ],
};
---

<BaseLayout title={item.title} description={item.body.slice(0, 120) || 'お知らせ'} ogType="article">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replaceAll('<', '\\u003c')} />
  <article class="page-section">
    <nav aria-label="パンくずリスト" class="mb-5">
      <ol class="flex flex-wrap items-center gap-x-2 text-[13px] text-ink-soft">
        {breadcrumbs.map((crumb, i) => (
          <li class="flex items-center gap-x-2">
            {i > 0 && <span aria-hidden="true">›</span>}
            <a href={crumb.href} class="py-1 transition-colors duration-150 hover:text-ink">{crumb.name}</a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="flex items-baseline gap-4">
      <time datetime={date} class="font-num text-[13px] text-ink-soft">{formattedDate}</time>
      <span class="glass-tag whitespace-nowrap">
        <i class={`${meta.icon} mr-1`} aria-hidden="true"></i>
        {meta.label}
      </span>
    </div>
    <h1 class="mt-4 text-2xl font-medium leading-snug text-ink">{item.title}</h1>

    {item.body && (
      <p class="mt-8 whitespace-pre-line leading-[1.9] text-ink">
        {item.bodySegments.map((seg) =>
          seg.href ? (
            <a
              href={seg.href}
              class="text-accent-text underline underline-offset-4 hover:text-ink"
              {...(seg.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >{seg.text}</a>
          ) : (
            seg.text
          )
        )}
      </p>
    )}

    {item.url && (
      <p class="mt-8">
        <a
          href={item.url}
          class="btn-glass"
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          関連リンクを開く
        </a>
      </p>
    )}

    <div class="mt-16 text-center">
      <a href="/news/" class="btn-glass btn-wide">
        <i class="fa-solid fa-arrow-left"></i>お知らせ一覧へ
      </a>
    </div>
  </article>
</BaseLayout>
