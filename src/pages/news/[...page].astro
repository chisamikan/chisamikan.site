---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import NewsCategoryFilter from '../../components/NewsCategoryFilter.astro';
import NewsList from '../../components/NewsList.astro';
import NewsPagination from '../../components/NewsPagination.astro';
import { getAllNewsItems, type NewsCategory } from '../../lib/news';

export const getStaticPaths = (async ({ paginate }) => {
  const items = await getAllNewsItems();
  return paginate(items, { pageSize: 20 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const categoryPath = (category: NewsCategory) => `/news/category/${category}`;
---

<BaseLayout title="News" description="サイトの更新履歴・お知らせ一覧です。">
  <section class="page-section">
    <SectionHeading eyebrow="News" title="お知らせ" level={1}>
      <a
        slot="action"
        href="/rss.xml"
        class="no-external-icon inline-flex shrink-0 items-center gap-1.5 text-sm font-medium text-accent-text transition-colors hover:text-ink"
      >
        <i class="fa-solid fa-rss" aria-hidden="true"></i>RSSで購読する
      </a>
    </SectionHeading>

    <NewsCategoryFilter allPath="/news" categoryPath={categoryPath} />

    <NewsList items={page.data} />

    <NewsPagination page={page} basePath="/news" />

    <div class="mt-16 text-center">
      <a href="/" class="btn-glass btn-wide">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>
  </section>
</BaseLayout>
