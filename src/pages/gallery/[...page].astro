---
import type { GetStaticPathsOptions, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getGalleryItems, type ArtworkItem } from '../../lib/notion';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const items = await getGalleryItems();
  return paginate(items, { pageSize: 9 });
}

interface Props {
  page: Page<ArtworkItem>;
}

const { page } = Astro.props;
const items = page.data;

// タグでの絞り込みは表示中のページ内の作品が対象です(静的生成のため)
const tags = Array.from(new Set(items.flatMap((i) => i.tags))).sort();
const tilts: Array<'1.5' | '-1.5' | '2.5' | '-2.5' | '0'> = ['0', '1.5', '-1.5', '2.5', '-2.5'];
---

<BaseLayout title="Gallery" description="これまでに描いたイラスト作品のギャラリーです。">
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <SectionHeading eyebrow="Selected Works" title="ギャラリー" color="marker" />

    {tags.length > 0 && (
      <div class="mb-10 flex flex-wrap gap-2" role="group" aria-label="タグで絞り込み">
        <button
          type="button"
          data-filter="all"
          class="filter-btn is-active rounded-full border border-ink/20 px-4 py-1.5 font-mono text-xs transition-colors"
        >
          すべて
        </button>
        {tags.map((tag) => (
          <button
            type="button"
            data-filter={tag}
            class="filter-btn rounded-full border border-ink/20 px-4 py-1.5 font-mono text-xs transition-colors"
          >
            {tag}
          </button>
        ))}
      </div>
    )}

    <div id="gallery-grid" class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item, i) => (
        <div data-tags={item.tags.join('|')}>
          <ArtworkCard item={item} tilt={tilts[i % tilts.length]} />
        </div>
      ))}
    </div>

    {items.length === 0 && (
      <p class="font-mono text-sm text-graphite">まだ作品が登録されていません。</p>
    )}

    {page.lastPage > 1 && (
      <nav aria-label="ページ送り" class="mt-16 flex items-center justify-center gap-4 font-mono text-sm">
        {page.url.prev ? (
          <a href={page.url.prev} class="rounded-sm border border-ink/20 px-4 py-2 transition-colors hover:border-marker hover:text-marker">
            &larr; 前へ
          </a>
        ) : (
          <span class="rounded-sm border border-ink/10 px-4 py-2 text-ink/30">&larr; 前へ</span>
        )}

        <span class="text-graphite">{page.currentPage} / {page.lastPage}</span>

        {page.url.next ? (
          <a href={page.url.next} class="rounded-sm border border-ink/20 px-4 py-2 transition-colors hover:border-marker hover:text-marker">
            次へ &rarr;
          </a>
        ) : (
          <span class="rounded-sm border border-ink/10 px-4 py-2 text-ink/30">次へ &rarr;</span>
        )}
      </nav>
    )}
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .filter-btn.is-active {
    @apply border-marker bg-marker text-white;
  }
</style>

<script>
  // タグボタンでの絞り込み(依存ライブラリなしのシンプルなvanilla JS)
  // 絞り込みは現在表示中のページ内の作品のみが対象です
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('#gallery-grid > [data-tags]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const filter = btn.dataset.filter;

      cards.forEach((card) => {
        const tags = (card.dataset.tags ?? '').split('|').filter(Boolean);
        const match = filter === 'all' || tags.includes(filter ?? '');
        card.style.display = match ? '' : 'none';
      });
    });
  });
</script>
