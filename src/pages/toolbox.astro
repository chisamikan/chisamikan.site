---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import List from '../components/List.astro';
import Lightbox from '../components/Lightbox.astro';
import { getToolboxItems } from '../lib/notion';

const items = await getToolboxItems();
---

<BaseLayout title="Tool Box" description="制作に使っているツールやサービスの紹介です。">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <SectionHeading eyebrow="Tool Box" title="ツールボックス" level={1} />

    <p class="-mt-6 mb-10 text-center font-mono text-sm text-graphite">
      これまで作ったスクリプトや素材を配布しています。
    </p>

    {items.length > 0 ? (
      <div id="toolbox-list">
        {items.map((item) => (
          <div class="card-reveal">
            <List type="toolbox" item={item} headingLevel={2} />
          </div>
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-graphite">まだツールが登録されていません。</p>
    )}

	<div class="mt-16 text-center">
      <a href="/contact" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-envelope pr-1"></i>ご依頼はこちら
      </a>
    </div>
    <div class="mt-8 text-center">
      <a href="/" class="btn-glass md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
