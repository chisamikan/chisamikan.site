---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import List from '../components/List.astro';
import Lightbox from '../components/Lightbox.astro';
import { getToolboxItems } from '../lib/notion';

const items = await getToolboxItems();
---

<BaseLayout title="Tool Box" description="制作に使っているツールやサービスの紹介です。">
  <section class="page-section">
    <SectionHeading eyebrow="Tool Box" title="ツールボックス" level={1} />

    <p class="page-lead">
      これまで作ったスクリプトや素材を配布しています。
    </p>

    {items.length > 0 ? (
      <div id="toolbox-list" class="border-b border-ink/10">
        {items.map((item) => (
          <div class="card-reveal">
            <List type="toolbox" item={item} headingLevel={2} />
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-graphite">まだツールが登録されていません。</p>
    )}

	<div class="mt-16 text-center">
      <a href="/contact" class="btn-glass btn-glass-accent btn-wide">
        <i class="fa-solid fa-envelope"></i>ご依頼はこちら
      </a>
    </div>
    <div class="mt-8 text-center">
      <a href="/" class="btn-glass btn-wide">
        <i class="fa-solid fa-arrow-left"></i>サイトトップへ
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
