---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import TagFilter from '../components/TagFilter.astro';
import { getGalleryItems } from '../lib/notion';

const items = await getGalleryItems();
const tags = Array.from(new Set(items.flatMap((i) => i.tags))).sort();
---

<BaseLayout title="Gallery" description="これまでに描いたイラスト作品のギャラリーです。">
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <SectionHeading eyebrow="Gallery" title="ギャラリー" level={1} />

    <TagFilter tags={tags} class="mb-10 flex flex-wrap justify-center gap-2" />

    <CardGrid id="gallery-grid" managed class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((item) => (
        <div class="card-reveal h-full" data-tags={item.tags.join('|')}>
          <Card type="artwork" item={item} headingLevel={2} />
        </div>
      ))}
    </CardGrid>

    {items.length === 0 && (
      <p class="font-mono text-sm text-graphite">まだ作品が登録されていません。</p>
    )}

    <!-- ページネーションは絞り込み結果の件数に応じてJSが表示/非表示・ページ数を計算する -->
    <nav
      id="pagination-nav"
      aria-label="ページ送り"
      class="mt-16 hidden items-center justify-center gap-2 font-mono text-sm"
    >
      <button type="button" id="prev-page" aria-label="前のページ" class="btn-glass-ghost px-3!">
        &lt;
      </button>
      <div id="page-numbers" class="flex items-center gap-2"></div>
      <button type="button" id="next-page" aria-label="次のページ" class="btn-glass-ghost px-3!">
        &gt;
      </button>
    </nav>

	<div class="mt-16 text-center">
      <a href="/contact" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-envelope pr-1"></i>ご依頼はこちら
      </a>
    </div>
    <div class="mt-8 text-center">
      <a href="/" class="btn-glass md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<script>
  // タグ絞り込みとページネーションをクライアント側で連動させる。
  // (絞り込み後の件数をもとにページ数を再計算するため、ページ遷移なしで完結する)
  // タグ絞り込みボタン自体のUIとactive状態の切り替えはTagFilter.astroに任せ、
  // このページはページ送りと連動させる必要があるため tagfilter:change イベントを
  // 購読して表示制御(件数計算・ページ割り)だけを自前で行う。
  import { matchesTag, revealItems } from '../lib/tagFilter';

  const PAGE_SIZE = 9;

  const grid = document.querySelector<HTMLElement>('#gallery-grid');
  const cards = Array.from(grid?.querySelectorAll<HTMLElement>(':scope > [data-tags]') ?? []);
  const filterGroup = document.querySelector<HTMLElement>('[data-tag-filter]');
  const nav = document.querySelector<HTMLElement>('#pagination-nav');
  const prevBtn = document.querySelector<HTMLButtonElement>('#prev-page');
  const nextBtn = document.querySelector<HTMLButtonElement>('#next-page');
  const pageNumbers = document.querySelector<HTMLElement>('#page-numbers');
  const loadingEl = document.querySelector<HTMLElement>('[data-card-grid-loading="gallery-grid"]');

  let currentFilter = 'all';
  let currentPage = 1;
  let isFirstRender = true;

  function showLoading() {
    loadingEl?.classList.remove('opacity-0');
    loadingEl?.setAttribute('aria-hidden', 'false');
  }

  function hideLoading() {
    loadingEl?.classList.add('opacity-0');
    loadingEl?.setAttribute('aria-hidden', 'true');
  }

  // 絞り込み/ページ送り直後は遅延読み込み(loading="lazy")の画像がまだ届いておらず、
  // 一瞬「該当なし」に見えてしまう。読み込み中の画像がある間だけスピナーで覆い隠し、
  // 「すべて」読み込み終わってから解決するPromiseを返す(呼び出し側はこれに続けて
  // カードのアニメーションを発火させ、スピナーとカード表示の間隔がズレないようにする)。
  function waitForVisibleImages(): Promise<void> {
    const pendingImages = cards
      .filter((card) => card.style.display !== 'none')
      .map((card) => card.querySelector('img'))
      .filter((img): img is HTMLImageElement => !!img && !img.complete);

    if (pendingImages.length === 0) return Promise.resolve();

    showLoading();
    return Promise.all(
      pendingImages.map(
        (img) =>
          new Promise<void>((resolve) => {
            img.addEventListener('load', () => resolve(), { once: true });
            img.addEventListener('error', () => resolve(), { once: true });
          }),
      ),
    ).then(() => {
      hideLoading();
    });
  }

  // current を中心とした3ページ分の窓(範囲外にはみ出す場合はスライド)を作り、
  // 先頭/末尾に接していなければその側に 1 (または total) と省略記号を追加する。
  function getPageItems(current: number, total: number): Array<number | 'ellipsis'> {
    let start = current - 1;
    let end = current + 1;
    if (start < 1) {
      end += 1 - start;
      start = 1;
    }
    if (end > total) {
      start -= end - total;
      end = total;
    }
    start = Math.max(start, 1);
    end = Math.min(end, total);

    const window: number[] = [];
    for (let page = start; page <= end; page += 1) window.push(page);

    const items: Array<number | 'ellipsis'> = [];
    if (window[0] === 1) {
      items.push(...window);
    } else {
      items.push(1, 'ellipsis', ...window);
    }
    if (window[window.length - 1] !== total) {
      items.push('ellipsis', total);
    }
    return items;
  }

  function goToPage(page: number) {
    currentPage = page;
    render();
    grid?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function render() {
    const filtered = cards.filter((card) => matchesTag(card, currentFilter));
    const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    const start = (currentPage - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;

    const cardsToReveal: HTMLElement[] = [];
    let visibleIndex = 0;
    cards.forEach((card) => {
      if (!matchesTag(card, currentFilter)) {
        card.style.display = 'none';
        return;
      }
      const show = visibleIndex >= start && visibleIndex < end;
      card.style.display = show ? '' : 'none';
      // 初回表示はスクロール連動のフェードインに任せるが、絞り込み/ページ送りで
      // 表示されたカードは、既に表示済みのものも含めてその場でスタッガー
      // アニメーションを再生する。(読み込み中の画像がある間はスピナーが覆い隠す
      // ため、二重待ちには感じない)
      if (show && !isFirstRender) {
        cardsToReveal.push(card);
      }
      visibleIndex += 1;
    });

    if (nav) nav.style.display = totalPages > 1 ? 'flex' : 'none';
    if (prevBtn) prevBtn.style.display = currentPage <= 1 ? 'none' : '';
    if (nextBtn) nextBtn.style.display = currentPage >= totalPages ? 'none' : '';

    if (pageNumbers) {
      pageNumbers.innerHTML = '';
      getPageItems(currentPage, totalPages).forEach((item) => {
        if (item === 'ellipsis') {
          const span = document.createElement('span');
          span.textContent = '…';
          span.className = 'px-1 text-ink/40';
          pageNumbers.appendChild(span);
          return;
        }

        const isActive = item === currentPage;
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = String(item);
        if (isActive) {
          btn.disabled = true;
          btn.setAttribute('aria-current', 'page');
          btn.className =
            'rounded-full border border-glass-border-subtle bg-glass px-3 py-1.5 text-ink/40 backdrop-blur-md cursor-not-allowed';
        } else {
          btn.className = 'btn-glass-ghost px-3!';
          btn.addEventListener('click', () => goToPage(item));
        }
        pageNumbers.appendChild(btn);
      });
    }

    waitForVisibleImages().then(() => revealItems(cardsToReveal));
    isFirstRender = false;
  }

  filterGroup?.addEventListener('tagfilter:change', (e) => {
    currentFilter = (e as CustomEvent<{ filter: string }>).detail.filter;
    currentPage = 1;
    render();
  });

  prevBtn?.addEventListener('click', () => goToPage(currentPage - 1));
  nextBtn?.addEventListener('click', () => goToPage(currentPage + 1));

  render();
</script>
