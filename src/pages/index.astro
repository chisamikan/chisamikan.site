---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import WorkItemCard from '../components/WorkItemCard.astro';
import NewsItem from '../components/NewsItem.astro';
import ProfileContent from '../components/ProfileContent.astro';
import SnsLinks from '../components/SnsLinks.astro';
import ContactForm from '../components/ContactForm.astro';
import Lightbox from '../components/Lightbox.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import { getGalleryItems, getWorkHistory } from '../lib/notion';
import { getNewsItems } from '../lib/rss';
import { site } from '../lib/config';

const [gallery, works, news] = await Promise.all([
  getGalleryItems(),
  getWorkHistory(),
  getNewsItems(5),
]);

const featuredGallery = gallery.slice(0, 3);
const latestWorks = works.slice(0, 3);

// ファーストビューの全画面イラスト: ギャラリーで「slideshow」がオンの作品(NSFWは除外)を
// スライドショー表示する。対象が無ければ先頭作品、それも無ければ用意したイラストを使用する
const slideshowImages = gallery
  .filter((item) => item.slideshow && !item.nsfw && item.imageUrl)
  .map((item) => item.imageUrl as string);
const heroImages =
  slideshowImages.length > 0
    ? slideshowImages
    : [gallery.find((item) => !item.nsfw && item.imageUrl)?.imageUrl ?? '/images/hero-illustration.svg'];
---

<BaseLayout>
  <!-- ページ全体のh1: 視覚的には非表示だが、ページの主題(サイト/作者)を検索エンジンとスクリーンリーダーに伝える -->
  <h1 class="sr-only">{site.description}</h1>

  <!-- ファーストビュー: 全画面イラスト -->
  <section class="relative h-[100svh] w-full overflow-hidden">
    <HeroSlideshow images={heroImages} />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/25 to-ink/5"></div>

    <div class="relative z-10 flex h-full flex-col justify-end px-6 pb-20 pt-16 sm:px-10 sm:pb-24">
      <div class="max-w-md rounded-xl border border-paper/20 bg-paper/10 p-5 text-left shadow-lg backdrop-blur-md sm:p-6">
        <h2 class="mb-4 font-display text-lg font-semibold tracking-tight text-paper sm:text-xl">
          お知らせ<span class="font-mono text-xs uppercase tracking-[0.25em] text-paper/80 pl-2">Latest News</span>
        </h2>
        {news.length > 0 ? (
          <ul>
            {news.slice(0, 3).map((item) => (
              <li class="border-b border-paper/20 py-3 first:pt-0 last:border-b-0">
                <a
                  href={item.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4"
                >
                  {item.date && (
                    <span class="shrink-0 font-mono text-xs text-paper/60">
                      {new Date(item.date).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                    </span>
                  )}
                  <span class="text-paper/90 transition-colors group-hover:text-accent">
                    {item.title}
                    <span class="ml-1 text-paper/60">&#8599;</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm leading-relaxed text-paper/85">お知らせはまだありません。</p>
        )}
        <div class="mt-6 text-right">
          <a
            href="#news"
            class="font-mono text-sm text-paper/90 underline underline-offset-4 transition-colors hover:text-accent"
          >
            お知らせをもっと見る &rarr;
          </a>
        </div>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-6 flex justify-center">
      <span class="animate-bounce font-mono text-xs tracking-widest text-paper/70">SCROLL &darr;</span>
    </div>
  </section>

  <!-- ギャラリー抜粋 -->
  <section id="gallery" class="mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
    <SectionHeading eyebrow="Gallery" title="ギャラリー" />
    <div class="grid gap-8 sm:grid-cols-3">
      {featuredGallery.map((item) => (
        <ArtworkCard item={item} />
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href="/gallery" class="btn-glass btn-glass-accent">
        すべての作品を見る &rarr;
      </a>
    </div>
  </section>

  <!-- プロフィール -->
  <section id="profile" class="mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Profile" title="プロフィール" />
    <div class="mx-auto max-w-2xl text-center">
      <ProfileContent />
      <SnsLinks />
    </div>
  </section>

  <!-- 仕事履歴(最新3件・PCでは3カラム表示) -->
  <section id="works" class="mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Works" title="仕事履歴" />
    {latestWorks.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3">
        {latestWorks.map((item) => <WorkItemCard item={item} />)}
      </div>
    ) : (
      <p class="font-mono text-sm text-graphite">まだ実績が登録されていません。</p>
    )}
    <div class="mt-10 text-center">
      <a href="/works" class="btn-glass btn-glass-accent">
        仕事履歴をすべて見る &rarr;
      </a>
    </div>
  </section>

  <!-- お問い合わせ -->
  <section id="contact" class="mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Contact" title="お問い合わせ" />
    <div class="mx-auto max-w-2xl text-center">
      <p class="mb-10 text-sm leading-relaxed text-ink/70">
        お仕事のご依頼・ご質問はこちらのフォームからお送りください。<br>
		内容を確認のうえ、折り返しご連絡いたします。
      </p>
      <ContactForm />
    </div>
  </section>

  <Lightbox />
</BaseLayout>
