---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import WorkItemCard from '../components/WorkItemCard.astro';
import NewsTicker from '../components/NewsTicker.astro';
import ProfileContent from '../components/ProfileContent.astro';
import SnsLinks from '../components/SnsLinks.astro';
import Lightbox from '../components/Lightbox.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import { getGalleryItems, getWorkHistory } from '../lib/notion';
import { getNewsItems } from '../lib/rss';
import { site } from '../lib/config';

const [gallery, works, news] = await Promise.all([
  getGalleryItems(),
  getWorkHistory(),
  getNewsItems(1),
]);

const featuredGallery = gallery.slice(0, 3);
const latestWorks = works.slice(0, 3);

// ファーストビューの全画面イラスト: ギャラリーで「slideshow」がオンの作品(NSFWは除外)を
// スライドショー表示する。対象が無ければ先頭作品、それも無ければ用意したイラストを使用する
const slideshowImages = gallery
  .filter((item) => item.slideshow && !item.nsfw && item.imageUrl)
  .map((item) => item.imageUrl as string);
const heroImages =
  slideshowImages.length > 0
    ? slideshowImages
    : [gallery.find((item) => !item.nsfw && item.imageUrl)?.imageUrl ?? '/images/hero-illustration.svg'];
---

<BaseLayout>
  <!-- ページ全体のh1: 視覚的には非表示だが、ページの主題(サイト/作者)を検索エンジンとスクリーンリーダーに伝える -->
  <h1 class="sr-only">{site.description}</h1>

  <!-- ファーストビュー: 全画面イラスト -->
  <section class="relative h-[100svh] w-full overflow-hidden">
    <HeroSlideshow images={heroImages} />
    <!-- ここから先はイラスト写真の上に重ねる常時ダークな覆い(スクリム)なので、
         ページのテーマ(paper/ink)ではなく固定の black/white を使い、ダークモードでも見た目を変えない -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/5"></div>

    <div class="relative z-10 flex h-full flex-col justify-end px-6 pb-20 pt-16 sm:px-10 sm:pb-24">
      <div class="max-w-md rounded-xl border border-white/20 bg-white/10 p-5 text-left shadow-lg backdrop-blur-md sm:p-6">
        {news.length > 0 ? (
          <NewsTicker item={news[0]} />
        ) : (
          <p class="flex items-center gap-2 text-sm leading-relaxed text-white/85">
            <i class="fa-solid fa-bullhorn shrink-0 text-white/80" aria-hidden="true"></i>
            お知らせはまだありません。
          </p>
        )}
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-6 flex justify-center">
      <span class="animate-bounce font-mono text-xs tracking-widest text-white/70">SCROLL &darr;</span>
    </div>
  </section>

  <!-- ギャラリー抜粋 -->
  <section id="gallery" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
    <SectionHeading eyebrow="Gallery" title="ギャラリー" />
    <div class="grid gap-8 sm:grid-cols-3">
      {featuredGallery.map((item) => (
        <ArtworkCard item={item} />
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href="/gallery" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>すべての作品を見る
      </a>
    </div>
  </section>

  <!-- プロフィール -->
  <section id="profile" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Profile" title="プロフィール" />
    <div class="mx-auto max-w-2xl text-center">
      <ProfileContent />
      <SnsLinks />
    </div>
  </section>

  <!-- 仕事履歴(最新3件・PCでは3カラム表示) -->
  <section id="works" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Works" title="仕事履歴" />
    {latestWorks.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-3">
        {latestWorks.map((item) => <WorkItemCard item={item} />)}
      </div>
    ) : (
      <p class="font-mono text-sm text-graphite">まだ実績が登録されていません。</p>
    )}
    <div class="mt-10 text-center">
      <a href="/works" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>仕事履歴をすべて見る
      </a>
    </div>
  </section>

  <section id="contact" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="contact" title="お問い合わせ" />
    <div class="mx-auto text-center">
      <p>イラスト / グラフィックデザイン / Webデザイン / ライティング等、幅広いコンテンツの制作を承ります。</p>
      <div class="mt-10 text-center">
        <a href="/contact" class="btn-glass btn-glass-accent md:w-1/3 w-full">
          <i class="fa-solid fa-circle-chevron-right pr-1"></i>ご依頼はこちら
        </a>
      </div>
    </div>
  </section>
  <Lightbox />
</BaseLayout>
