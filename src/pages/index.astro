---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import CardSlider from '../components/CardSlider.astro';
import NewsList from '../components/NewsList.astro';
import NewsTicker from '../components/NewsTicker.astro';
import AccessCounter from '../components/AccessCounter.astro';
import ProfileContent from '../components/ProfileContent.astro';
import Lightbox from '../components/Lightbox.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import { getGalleryItems, getNovelItems, getToolboxItems } from '../lib/notion';
import { getAllNewsItems } from '../lib/news';
import { getBoothItems } from '../lib/booth';
import { site } from '../lib/config';

const [gallery, novels, toolbox, news, shopItems] = await Promise.all([
  getGalleryItems(),
  getNovelItems(),
  getToolboxItems(),
  getAllNewsItems(),
  getBoothItems(10),
]);

// スライダー表示のため抜粋件数を増やす。画像はCard側でloading="lazy"のままで、
// スライダー2ページ目以降のカードはスクロールして見えるまで読み込まれないため
// ページ初期読み込みへの影響はほぼ増えない。カードは固定幅(約19rem)表示のため、
// 横幅の広い画面では一度に見える枚数が増える分、件数にも余裕を持たせる
// ファーストビューの「NEW」の札は「お知らせ(note)」の最新1件のみを表示する
const latestNote = news.find((item) => item.category === 'note');

const featuredGallery = gallery.slice(0, 10);
const featuredNovels = novels.slice(0, 10);
const featuredToolbox = toolbox.slice(0, 10);

// ファーストビュー: ギャラリーで「slideshow」がオンの作品(NSFWは除外)をスライドショー表示する。
// 対象が無ければ先頭作品、それも無ければ用意したイラストを使用する
const slideshowImages = gallery
  .filter((item) => item.slideshow && !item.nsfw && item.imageUrl)
  .map((item) => item.imageUrl as string);
const heroImages =
  slideshowImages.length > 0
    ? slideshowImages
    : [gallery.find((item) => !item.nsfw && item.imageUrl)?.imageUrl ?? '/images/work-placeholder.svg'];
---

<BaseLayout>
  <!-- ファーストビュー: 全画面イラスト。ヘッダーは背景を持たない浮かぶ部品なので、
    その高さぶん上に引き上げてイラストをヘッダーの裏まで敷く -->
  <section class="relative mt-[calc(-1*var(--mobile-header-h,4.5rem))] h-svh min-h-140 w-full overflow-hidden">
    <HeroSlideshow images={heroImages} />
    <!-- イラストに重ねる常時ダークな覆い。ページのテーマではなく固定の紺色を使い、文字の下だけを暗くする -->
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(4,18,36,0.75)_0%,rgba(4,18,36,0.25)_40%,rgba(4,18,36,0)_62%),linear-gradient(to_bottom,rgba(4,18,36,0.5),rgba(4,18,36,0)_26%)]"></div>

    <!-- 狭い画面では、サイト名と「NEW」の札を左寄せの縦並びにして下端に寄せる -->
    <div class="relative z-10 flex h-full flex-col items-start justify-end gap-6 px-4 pb-10 sm:flex-row sm:flex-wrap sm:items-end sm:justify-between sm:px-8 sm:pb-12 lg:px-12">
      <div class="text-white">
        <p class="text-xs font-medium uppercase tracking-[0.16em] text-white/75">Illustration / Design / Writing</p>
        <!-- 画面に見えているサイト名をページのh1にする。ページの主題(サイト/作者)は
          視覚的には非表示の補足として添え、検索エンジンとスクリーンリーダーに伝える -->
        <h1 class="mt-3 text-[clamp(3.5rem,11vw,9rem)] font-semibold leading-[0.9] tracking-[-0.05em] text-white">
          Chisa<br />Mikan.site<span class="sr-only"> — {site.description}</span>
        </h1>
      </div>

      {latestNote && <NewsTicker item={latestNote} />}
    </div>
  </section>

  <!-- お知らせ(統合フィードの最新3件) -->
  <section id="news" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
    <SectionHeading eyebrow="News" title="お知らせ" href="/news" />
    <NewsList items={news.slice(0, 3)} />
  </section>

  <!-- プロフィール -->
  <section id="profile" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Profile" title="プロフィール" href="/profile" linkLabel="もっと見る" />
    <ProfileContent showSkills={false} layout="split" />
  </section>

  <!-- ギャラリー抜粋 -->
  <section id="gallery" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Gallery" title="ギャラリー" href="/gallery" />
    <CardSlider id="home-gallery-slider" count={featuredGallery.length}>
      {featuredGallery.map((item) => (
        <div class="card-reveal h-full">
          <Card type="artwork" item={item} />
        </div>
      ))}
    </CardSlider>
  </section>

  <!-- 小説抜粋 -->
  <section id="novels" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Novels" title="小説" href="/novels" />
    {featuredNovels.length > 0 ? (
      <CardSlider id="home-novels-slider" count={featuredNovels.length}>
        {featuredNovels.map((item) => (
          <div class="card-reveal h-full">
            <Card type="novel" item={item} />
          </div>
        ))}
      </CardSlider>
    ) : (
      <p class="text-sm text-graphite">まだ小説作品が登録されていません。</p>
    )}
  </section>

  <!-- ツールボックス(最新3件) -->
  <section id="toolbox" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Tool Box" title="ツールボックス" href="/toolbox" />
    {featuredToolbox.length > 0 ? (
      <CardSlider id="home-toolbox-slider" count={featuredToolbox.length}>
        {featuredToolbox.map((item) => (
          <div class="card-reveal h-full">
            <Card type="toolbox" item={item} />
          </div>
        ))}
      </CardSlider>
    ) : (
      <p class="text-sm text-graphite">まだツールが登録されていません。</p>
    )}
  </section>

  <!-- BOOTHショップ(最新9件) -->
  <section id="shop" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Shop" title="ショップ" href={import.meta.env.BOOTH_SHOP_URL || '#'} linkLabel="BOOTHで見る" />
    {shopItems.length > 0 ? (
      <CardSlider id="home-shop-slider" count={shopItems.length}>
        {shopItems.map((item) => (
          <div class="card-reveal h-full">
            <Card type="shop" item={item} />
          </div>
        ))}
      </CardSlider>
    ) : (
      <p class="text-sm text-graphite">まだ商品が登録されていません。</p>
    )}
  </section>

  <section id="contact" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Contact" title="お問い合わせ" />
    <div class="mx-auto text-center">
      <p class="page-lead">イラスト / グラフィックデザイン / Webデザイン / ライティング等、幅広いコンテンツの制作を承ります。</p>
      <div class="mt-10 text-center">
        <a href="/contact" class="btn-glass btn-glass-accent btn-wide">
          <i class="fa-solid fa-envelope"></i>ご依頼はこちら
        </a>
      </div>
    </div>
  </section>

  <!-- アクセスカウンター -->
  <section class="reveal mx-auto max-w-5xl px-6 pb-16">
    <AccessCounter />
  </section>
  <Lightbox />
</BaseLayout>
