---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import NewsTicker from '../components/NewsTicker.astro';
import AccessCounter from '../components/AccessCounter.astro';
import ProfileContent from '../components/ProfileContent.astro';
import Lightbox from '../components/Lightbox.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import { getGalleryItems, getNovelItems, getToolboxItems } from '../lib/notion';
import { getNewsItems } from '../lib/rss';
import { getBoothItems } from '../lib/booth';
import { site } from '../lib/config';

const [gallery, novels, toolbox, news, shopItems] = await Promise.all([
  getGalleryItems(),
  getNovelItems(),
  getToolboxItems(),
  getNewsItems(3),
  getBoothItems(3),
]);

const featuredGallery = gallery.slice(0, 3);
const featuredNovels = novels.slice(0, 3);
const featuredToolbox = toolbox.slice(0, 3);

// ファーストビュー: ギャラリーで「slideshow」がオンの作品(NSFWは除外)をスライドショー表示する。
// 対象が無ければ先頭作品、それも無ければ用意したイラストを使用する
const slideshowImages = gallery
  .filter((item) => item.slideshow && !item.nsfw && item.imageUrl)
  .map((item) => item.imageUrl as string);
const heroImages =
  slideshowImages.length > 0
    ? slideshowImages
    : [gallery.find((item) => !item.nsfw && item.imageUrl)?.imageUrl ?? '/images/work-placeholder.svg'];
---

<BaseLayout>
  <!-- ページ全体のh1: 視覚的には非表示だが、ページの主題(サイト/作者)を検索エンジンとスクリーンリーダーに伝える -->
  <h1 class="sr-only">{site.description}</h1>

  <!-- ファーストビュー: 全画面イラスト -->
  <section class="relative h-svh w-full overflow-hidden">
    <HeroSlideshow images={heroImages} />
    <!-- イラストに重ねる常時ダークな覆い。ページのテーマではなく固定の black/white を使う -->
    <div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/25 to-black/5"></div>

    <div class="relative z-10 flex h-full flex-col justify-end px-6 pb-6 pt-16 sm:px-10 sm:pb-10">
      <div class="max-w-md rounded-xl border border-white/20 bg-white/10 p-5 text-left shadow-lg backdrop-blur-md sm:p-6">
        {news.length > 0 ? (
          <NewsTicker item={news[0]} />
        ) : (
          <p class="flex items-center gap-2 text-sm leading-relaxed text-white/85">
            <i class="fa-solid fa-bullhorn shrink-0 text-white/80" aria-hidden="true"></i>
            お知らせはまだありません。
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- お知らせ(RSSフィードの最新3件) -->
  <section id="news" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 py-24">
    <SectionHeading eyebrow="News" title="お知らせ" />
    {news.length > 0 ? (
      <ul class="mx-auto max-w-2xl divide-y divide-ink/10">
        {news.slice(0, 3).map((item) => (
          <li class="py-4 first:pt-0 last:pb-0">
            <a
              href={item.link}
              target="_blank"
              rel="noopener noreferrer"
              class="no-external-icon group flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4"
            >
              {item.date && (
                <span class="shrink-0 font-mono text-xs text-graphite">
                  {new Date(item.date).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
                </span>
              )}
              <span class="text-ink transition-colors group-hover:text-accent">
                {item.title}
                <i class="fa-solid fa-arrow-up-right-from-square ml-0.5 text-[0.8em]" aria-hidden="true"></i>
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-center font-mono text-sm text-graphite">お知らせはまだありません。</p>
    )}
    <div class="mt-10 text-center">
      <a
        href="https://note.com/chisamikan"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-glass btn-glass-accent md:w-1/3 w-full"
      >
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>お知らせをもっと見る
      </a>
    </div>
  </section>

  <!-- プロフィール -->
  <section id="profile" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Profile" title="プロフィール" />
    <div class="mx-auto max-w-2xl text-center">
      <ProfileContent showSkills={false} />
    </div>
    <div class="mt-10 text-center">
      <a href="/profile" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>プロフィールをもっと見る
      </a>
    </div>
  </section>

  <!-- ギャラリー抜粋 -->
  <section id="gallery" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Gallery" title="ギャラリー" />
    <div class="grid gap-8 sm:grid-cols-3">
      {featuredGallery.map((item) => (
        <div class="card-reveal h-full">
          <Card type="artwork" item={item} />
        </div>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a href="/gallery" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>すべての作品を見る
      </a>
    </div>
  </section>

  <!-- 小説抜粋 -->
  <section id="novels" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Novels" title="小説" />
    {featuredNovels.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-3">
        {featuredNovels.map((item) => (
          <div class="card-reveal h-full">
            <Card type="novel" item={item} />
          </div>
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-graphite">まだ小説作品が登録されていません。</p>
    )}
    <div class="mt-10 text-center">
      <a href="/novels" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>すべての小説を見る
      </a>
    </div>
  </section>

  <!-- ツールボックス(最新3件) -->
  <section id="toolbox" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Tool Box" title="ツールボックス" />
    {featuredToolbox.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-3">
        {featuredToolbox.map((item) => (
          <div class="card-reveal h-full">
            <Card type="toolbox" item={item} />
          </div>
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-graphite">まだツールが登録されていません。</p>
    )}
    <div class="mt-10 text-center">
      <a href="/toolbox" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>配布物をすべて見る
      </a>
    </div>
  </section>

  <!-- BOOTHショップ(最新9件) -->
  <section id="shop" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="Shop" title="ショップ" />
    {shopItems.length > 0 ? (
      <div class="grid gap-8 sm:grid-cols-3">
        {shopItems.map((item) => (
          <div class="card-reveal h-full">
            <Card type="shop" item={item} />
          </div>
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-graphite">まだ商品が登録されていません。</p>
    )}
    <div class="mt-10 text-center">
      <a
        href={import.meta.env.BOOTH_SHOP_URL || '#'}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-glass btn-glass-accent md:w-1/3 w-full"
      >
        <i class="fa-solid fa-circle-chevron-right pr-1"></i>BOOTHショップを見る
      </a>
    </div>
  </section>

  <section id="contact" class="reveal mx-auto max-w-5xl scroll-mt-20 px-6 pb-24">
    <SectionHeading eyebrow="contact" title="お問い合わせ" />
    <div class="mx-auto text-center">
      <p>イラスト / グラフィックデザイン / Webデザイン / ライティング等、幅広いコンテンツの制作を承ります。</p>
      <div class="mt-10 text-center">
        <a href="/contact" class="btn-glass btn-glass-accent md:w-1/3 w-full">
          <i class="fa-solid fa-envelope pr-1"></i>ご依頼はこちら
        </a>
      </div>
    </div>
  </section>

  <!-- アクセスカウンター -->
  <section class="reveal mx-auto max-w-5xl px-6 pb-16">
    <AccessCounter />
  </section>
  <Lightbox />
</BaseLayout>
