---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import List from '../components/List.astro';
import Lightbox from '../components/Lightbox.astro';
import TagFilter from '../components/TagFilter.astro';
import { getNovelItems } from '../lib/notion';

const novels = await getNovelItems();
const tags = Array.from(new Set(novels.flatMap((i) => i.tags))).sort();
---

<BaseLayout title="Novels" description="これまでに執筆した小説作品の一覧です。">
  <section class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <SectionHeading eyebrow="Novels" title="小説" level={1} />

    <TagFilter tags={tags} containerSelector="#novels-list" emptySelector="#novels-empty" />

    {novels.length > 0 ? (
      <div id="novels-list">
        {novels.map((item) => (
          <div class="card-reveal" data-tags={item.tags.join('|')}>
            <List type="novel" item={item} headingLevel={2} />
          </div>
        ))}
      </div>
    ) : (
      <p class="font-mono text-sm text-graphite">まだ小説作品が登録されていません。</p>
    )}

    <p id="novels-empty" class="hidden font-mono text-sm text-graphite">
      該当するタグの作品がありません。
    </p>

	<div class="mt-16 text-center">
      <a href="/contact" class="btn-glass btn-glass-accent md:w-1/3 w-full">
        <i class="fa-solid fa-envelope pr-1"></i>ご依頼はこちら
      </a>
    </div>
    <div class="mt-8 text-center">
      <a href="/" class="btn-glass md:w-1/3 w-full">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>
  </section>

  <Lightbox />
</BaseLayout>
