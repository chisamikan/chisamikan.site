---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getOmikujiItems } from '../lib/notion';

const omikujiItems = await getOmikujiItems();

const introText = 'せっかくこんなところへ来たんだし、俺の自作おみくじを引いていくか？';
const omikujiAvatarBase = '/images/omikuji';

const omikujiFields = [
  { key: 'wish', label: '願望' },
  { key: 'waitingPerson', label: '待人' },
  { key: 'lostItem', label: '失物' },
  { key: 'travel', label: '旅行' },
  { key: 'business', label: '商売' },
  { key: 'study', label: '学問' },
  { key: 'love', label: '恋愛' },
  { key: 'moving', label: '転居' },
  { key: 'illness', label: '病気' },
  { key: 'direction', label: '方位' },
] as const;
---

<BaseLayout title="404 Not Found" description="お探しのページが見つかりませんでした。">
  <section class="mx-auto max-w-3xl px-6 py-24 sm:py-32 text-center">
    <SectionHeading eyebrow="404" title="ページが見つかりません" level={1} />

    <p class="mb-10 font-mono text-sm leading-relaxed text-ink-soft">
      お探しのページは移動または削除された可能性があります。<br />
      URLが正しいかご確認いただくか、下記のリンクからサイトトップへお戻りください。
    </p>

    {omikujiItems.length > 0 && (
      <div class="omikuji-box mx-auto max-w-xl rounded-2xl border border-glass-border-subtle bg-glass p-6 backdrop-blur-xl sm:p-8 mb-16">
        <h2 id="omikuji-title" class="mb-4 text-xl font-bold text-ink sm:text-2xl"><i class="fa-solid fa-torii-gate"></i>蛇川神社 おみくじ</h2>
        <div id="omikuji-intro" class="mb-6">
          <div class="line-mock-body">
            <div class="line-mock-row">
              <div class="line-mock-avatar" style={`background-image:url(${omikujiAvatarBase}/normal.png)`}></div>
              <div class="line-mock-bubble">
                <span id="omikuji-intro-message">{introText}</span>
              </div>
            </div>
          </div>
        </div>

        <h3 id="omikuji-heading" class="mb-6 hidden text-lg font-semibold text-ink italic">
          今日のあなたの運勢は……？
        </h3>

        <button id="omikuji-draw" type="button" class="btn-glass btn-glass-accent w-full md:max-w-1/2">
          <i class="fa-solid fa-scroll pr-1" aria-hidden="true"></i>おみくじを引く
        </button>

        <div id="omikuji-result" class="hidden mt-6 text-left">
          <div class="mb-6 text-center">
            <p id="omikuji-fortune" class="omikuji-reveal-item text-4xl font-bold text-accent"></p>
          </div>

          <div id="omikuji-line" class="omikuji-reveal-item mb-6">
            <div class="line-mock-body">
              <div class="line-mock-row">
                <div id="omikuji-line-avatar" class="line-mock-avatar"></div>
                <div class="line-mock-bubble">
                  <span id="omikuji-line-message"></span>
                </div>
              </div>
            </div>
          </div>

          <dl id="omikuji-detail" class="font-mono text-sm text-ink-soft"></dl>

          <div class="omikuji-reveal-item mt-6 flex flex-col items-center gap-3">
            <button id="omikuji-share" type="button" class="btn-glass btn-glass-accent w-full md:max-w-1/2">
              <i class="fa-solid fa-share-nodes pr-1" aria-hidden="true"></i>結果をシェアする
            </button>
            <button id="omikuji-redraw" type="button" class="btn-glass w-full md:max-w-1/2">
              <i class="fa-solid fa-rotate-right pr-1" aria-hidden="true"></i>もう一度引く
            </button>
          </div>
        </div>
      </div>
    )}

	<div class="mx-auto max-w-xs">
      <a href="/" class="btn-glass w-full">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>
  </section>

  <script
    is:inline
    define:vars={{ items: omikujiItems, fields: omikujiFields, omikujiAvatarBase }}
  >
    const intro = document.getElementById('omikuji-intro');
    const heading = document.getElementById('omikuji-heading');
    const button = document.getElementById('omikuji-draw');
    const result = document.getElementById('omikuji-result');
    const fortuneEl = document.getElementById('omikuji-fortune');
    const detailEl = document.getElementById('omikuji-detail');
    const lineAvatar = document.getElementById('omikuji-line-avatar');
    const lineMessage = document.getElementById('omikuji-line-message');
    const shareButton = document.getElementById('omikuji-share');
    const redrawButton = document.getElementById('omikuji-redraw');
    const titleEl = document.getElementById('omikuji-title');
    const introMessageEl = document.getElementById('omikuji-intro-message');

    let drawnItem = null;

    // 運勢の吉凶に応じてアバター画像を3段階(good/normal/bad)で出し分ける
    const GOOD_FORTUNES = ['大吉', '吉'];
    const BAD_FORTUNES = ['末吉', '凶'];

    function getAvatarUrl(fortune) {
      if (GOOD_FORTUNES.includes(fortune)) return `${omikujiAvatarBase}/good.png`;
      if (BAD_FORTUNES.includes(fortune)) return `${omikujiAvatarBase}/bad.png`;
      return `${omikujiAvatarBase}/normal.png`;
    }

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // メッセージ吹き出し(.line-mock-bubble)のテキストを1文字ずつ表示するタイピング風アニメーション。
    // 同じ要素で連打(再抽選)された場合に前のタイマーが残って文字が混ざらないよう、
    // 要素自身にタイマーIDを持たせて必ず先にクリアする。
    function typeText(el, text, speed = 32) {
      if (el._typingTimer) {
        clearInterval(el._typingTimer);
        el._typingTimer = null;
      }

      const bubble = el.closest('.line-mock-bubble');

      if (prefersReducedMotion || !text) {
        el.textContent = text || '';
        if (bubble) bubble.style.minHeight = '';
        return;
      }

      // 先に全文を描画して吹き出しの最終的な高さを計測し、min-heightとして
      // 固定してから改めて空にする。これによりタイピング中に文字が増えて
      // 縦幅が変化しても、アバターや三角の位置が動かなくなる。
      if (bubble) {
        bubble.style.minHeight = '';
        el.textContent = text;
        bubble.style.minHeight = `${bubble.offsetHeight}px`;
      }

      el.textContent = '';
      let i = 0;
      el._typingTimer = setInterval(() => {
        el.textContent += text[i];
        i += 1;
        if (i >= text.length) {
          clearInterval(el._typingTimer);
          el._typingTimer = null;
        }
      }, speed);
    }

    if (introMessageEl) {
      typeText(introMessageEl, introMessageEl.textContent, 32);
    }

    function wrapCanvasText(ctx, text, maxWidth) {
      const lines = [];
      let line = '';
      for (const ch of text || '') {
        const test = line + ch;
        if (line && ctx.measureText(test).width > maxWidth) {
          lines.push(line);
          line = ch;
        } else {
          line = test;
        }
      }
      if (line) lines.push(line);
      return lines;
    }

    function capLines(lines, max) {
      if (lines.length <= max) return lines;
      const capped = lines.slice(0, max);
      capped[max - 1] = capped[max - 1].slice(0, -1) + '…';
      return capped;
    }

    function loadImage(url) {
      return new Promise((resolve) => {
        if (!url) {
          resolve(null);
          return;
        }
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = () => resolve(null);
        img.src = url;
      });
    }

    function drawImageCover(ctx, img, x, y, w, h) {
      const imgRatio = img.width / img.height;
      const boxRatio = w / h;
      let sx, sy, sw, sh;
      if (imgRatio > boxRatio) {
        sh = img.height;
        sw = sh * boxRatio;
        sx = (img.width - sw) / 2;
        sy = 0;
      } else {
        sw = img.width;
        sh = sw / boxRatio;
        sx = 0;
        sy = (img.height - sh) / 2;
      }
      ctx.drawImage(img, sx, sy, sw, sh, x, y, w, h);
    }

    function drawRoundedRect(ctx, x, y, w, h, radius) {
      ctx.beginPath();
      ctx.moveTo(x + radius, y);
      ctx.arcTo(x + w, y, x + w, y + h, radius);
      ctx.arcTo(x + w, y + h, x, y + h, radius);
      ctx.arcTo(x, y + h, x, y, radius);
      ctx.arcTo(x, y, x + w, y, radius);
      ctx.closePath();
    }

    async function buildShareImage(item, avatarImg) {
      if (document.fonts?.ready) {
        await document.fonts.ready;
      }

      const width = 1080;
      const contentWidth = 780;
      const contentX = (width - contentWidth) / 2;

      // 実際のcanvasサイズを決める前に、可変長のテキストを仮のcontextで
      // 折り返した行数から必要な高さを算出する(2パス方式でクリッピングを防ぐ)
      const measureCanvas = document.createElement('canvas');
      const mctx = measureCanvas.getContext('2d');

      const avatarSize = 148;
      const bubbleGap = 28;
      const bubbleTextWidth = contentWidth - avatarSize - bubbleGap - 56;
      mctx.font = '400 27px "Zen Kaku Gothic New", sans-serif';
      const messageLines = capLines(wrapCanvasText(mctx, item.overall, bubbleTextWidth), 6);

      const detailRowHeight = 68;
      const detailFields = fields.map(({ key, label }) => [label, item[key] || '—']);

      const headerY = 96;
      const fortuneY = headerY + 190;

      const lineBlockY = fortuneY + 90;
      const bubblePaddingY = 30;
      const bubbleTextHeight = messageLines.length * 38;
      const bubbleHeight = Math.max(avatarSize, bubbleTextHeight + bubblePaddingY * 2);

      const detailStartY = lineBlockY + bubbleHeight + 70;
      const detailHeight = detailFields.length * detailRowHeight;

      const footerY = detailStartY + detailHeight + 70;
      const height = Math.round(footerY + 40);

      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');

      ctx.fillStyle = '#0b0e1a';
      ctx.fillRect(0, 0, width, height);

      const glow = ctx.createRadialGradient(
        width / 2, fortuneY, 40,
        width / 2, fortuneY, 520
      );
      glow.addColorStop(0, 'rgba(94, 231, 223, 0.25)');
      glow.addColorStop(1, 'rgba(94, 231, 223, 0)');
      ctx.fillStyle = glow;
      ctx.fillRect(0, 0, width, height);

      ctx.textAlign = 'center';
      ctx.textBaseline = 'alphabetic';

      ctx.fillStyle = 'rgba(255, 255, 255, 0.72)';
      ctx.font = '600 26px "Zen Kaku Gothic New", sans-serif';
      ctx.fillText('蛇川神社 おみくじ', width / 2, headerY);

      ctx.fillStyle = '#5ee7df';
      ctx.font = '700 150px "Zen Kaku Gothic New", sans-serif';
      ctx.fillText(item.fortune, width / 2, fortuneY);

      const avatarX = contentX;
      const avatarY = lineBlockY;
      const bubbleX = avatarX + avatarSize + bubbleGap;
      const bubbleY = avatarY + (avatarSize - bubbleHeight) / 2;
      const bubbleWidth = contentWidth - avatarSize - bubbleGap;

      ctx.save();
      ctx.beginPath();
      ctx.arc(avatarX + avatarSize / 2, avatarY + avatarSize / 2, avatarSize / 2, 0, Math.PI * 2);
      ctx.closePath();
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      if (avatarImg) {
        ctx.clip();
        drawImageCover(ctx, avatarImg, avatarX, avatarY, avatarSize, avatarSize);
      }
      ctx.restore();

      ctx.fillStyle = '#ffffff';
      drawRoundedRect(ctx, bubbleX, bubbleY, bubbleWidth, bubbleHeight, 24);
      ctx.fill();

      ctx.fillStyle = '#111111';
      ctx.font = '400 27px "Zen Kaku Gothic New", sans-serif';
      ctx.textAlign = 'left';
      const bubbleTextX = bubbleX + 28;
      const bubbleTextStartY = bubbleY + bubblePaddingY + 24;
      messageLines.forEach((line, i) => {
        ctx.fillText(line, bubbleTextX, bubbleTextStartY + i * 38);
      });

      ctx.textAlign = 'left';
      const labelWidth = 150;
      detailFields.forEach(([label, value], i) => {
        const rowY = detailStartY + i * detailRowHeight;

        if (i > 0) {
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(contentX, rowY - detailRowHeight / 2);
          ctx.lineTo(contentX + contentWidth, rowY - detailRowHeight / 2);
          ctx.stroke();
        }

        ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
        ctx.font = '700 28px "Zen Kaku Gothic New", sans-serif';
        ctx.fillText(label, contentX, rowY);

        ctx.fillStyle = 'rgba(255, 255, 255, 0.75)';
        ctx.font = '400 28px "Zen Kaku Gothic New", sans-serif';
        ctx.fillText(value, contentX + labelWidth, rowY);
      });

      ctx.textAlign = 'center';
      ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
      ctx.font = '400 22px "Zen Kaku Gothic New", sans-serif';
      ctx.fillText('chisamikan.site', width / 2, footerY);

      return await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
    }

    shareButton?.addEventListener('click', async () => {
      if (!drawnItem) return;

      shareButton.disabled = true;
      const originalHTML = shareButton.innerHTML;
      shareButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin pr-1" aria-hidden="true"></i>作成中…';

      try {
        const avatarImg = await loadImage(getAvatarUrl(drawnItem.fortune));
        const blob = await buildShareImage(drawnItem, avatarImg);
        const fileName = `omikuji-${drawnItem.fortune}.png`;
        const shareText = `【#蛇川神社おみくじ】今日の運勢は「${drawnItem.fortune}」でした。\nhttps://chisamikan.site/`;
        const file = new File([blob], fileName, { type: 'image/png' });

        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: '蛇川神社 おみくじ', text: shareText });
        } else {
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = fileName;
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(url), 10000);

          const intentUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}`;
          window.open(intentUrl, '_blank', 'noopener,noreferrer');
        }
      } catch (err) {
        if (err?.name !== 'AbortError') {
          console.error('[omikuji] シェア画像の作成に失敗しました:', err);
        }
      } finally {
        shareButton.disabled = false;
        shareButton.innerHTML = originalHTML;
      }
    });

    function drawOmikuji() {
      const item = items[Math.floor(Math.random() * items.length)];
      drawnItem = item;

      fortuneEl.textContent = item.fortune;
      detailEl.innerHTML = fields
        .map(({ key, label }) => {
          const value = item[key] || '—';
          return `<div class="omikuji-detail-row omikuji-reveal-item"><dt>${label}</dt><dd>${value}</dd></div>`;
        })
        .join('');

      lineAvatar.style.backgroundImage = `url(${getAvatarUrl(item.fortune)})`;
      lineMessage.textContent = '';

      intro?.classList.add('hidden');
      heading.classList.remove('hidden');
      result.classList.remove('hidden');
      button.classList.add('hidden');

      playRevealAnimation();
    }

    function playRevealAnimation() {
      const revealItems = result.querySelectorAll('.omikuji-reveal-item');
      revealItems.forEach((el) => el.classList.remove('is-visible'));

      // is-visible を外した直後の非表示状態を1フレーム描画させてから付け直すことで、
      // 再抽選のたびにも毎回フェードインが再生されるようにする
      requestAnimationFrame(() => {
        revealItems.forEach((el, i) => {
          setTimeout(() => {
            el.classList.add('is-visible');
            if (el.id === 'omikuji-line' && drawnItem) {
              typeText(lineMessage, drawnItem.overall, 32);
            }
          }, i * 150);
        });
      });
    }

    button?.addEventListener('click', drawOmikuji);
    redrawButton?.addEventListener('click', () => {
      drawOmikuji();
      titleEl?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  </script>
</BaseLayout>
