---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getOmikujiItems, getOmikujiMessageItems } from '../lib/notion';

const omikujiItems = await getOmikujiItems();
const omikujiMessages = await getOmikujiMessageItems();

const introMessage = omikujiMessages.find((m) => m.fortune === '中吉') ?? null;
const introText = 'せっかくこんなところへ来たんだし、俺の自作おみくじを引いていくか？';

const omikujiFields = [
  { key: 'wish', label: '願望' },
  { key: 'waitingPerson', label: '待人' },
  { key: 'lostItem', label: '失物' },
  { key: 'travel', label: '旅行' },
  { key: 'business', label: '商売' },
  { key: 'study', label: '学問' },
  { key: 'love', label: '恋愛' },
  { key: 'moving', label: '転居' },
  { key: 'illness', label: '病気' },
  { key: 'direction', label: '方位' },
] as const;
---

<BaseLayout title="404 Not Found" description="お探しのページが見つかりませんでした。">
  <section class="mx-auto max-w-3xl px-6 py-24 sm:py-32 text-center">
    <SectionHeading eyebrow="404" title="ページが見つかりません" level={1} />

    <p class="mb-10 font-mono text-sm leading-relaxed text-ink-soft">
      お探しのページは移動または削除された可能性があります。<br />
      URLが正しいかご確認いただくか、下記のリンクからサイトトップへお戻りください。
    </p>

    <div class="mx-auto max-w-xs mb-16">
      <a href="/" class="btn-glass w-full">
        <i class="fa-solid fa-circle-chevron-left pr-1"></i>サイトトップへ
      </a>
    </div>

    {omikujiItems.length > 0 && (
      <div class="omikuji-box mx-auto max-w-xl rounded-2xl border border-glass-border-subtle bg-glass p-6 backdrop-blur-xl sm:p-8">
        <h2 class="mb-4 text-xl font-bold text-ink sm:text-2xl"><i class="fa-solid fa-torii-gate"></i>蛇川神社 おみくじ</h2>
        {introMessage && (
          <div id="omikuji-intro" class="mb-6">
            <div class="line-mock-body">
              <div class="line-mock-row">
                <div
                  class="line-mock-avatar"
                  style={introMessage.imageUrl ? `background-image:url(${introMessage.imageUrl})` : undefined}
                >
                  {!introMessage.imageUrl && '🔮'}
                </div>
                <div class="line-mock-bubble">
                  <span>{introText}</span>
                </div>
              </div>
            </div>
          </div>
        )}

        <h3 id="omikuji-heading" class="mb-6 hidden text-lg font-semibold text-ink italic">
          今日のあなたの運勢は……？
        </h3>

        <button id="omikuji-draw" type="button" class="btn-glass btn-glass-accent">
          <i class="fa-solid fa-scroll pr-1" aria-hidden="true"></i>おみくじを引く
        </button>

        <div id="omikuji-result" class="hidden mt-6 text-left">
          <div class="mb-6 text-center">
            <p id="omikuji-fortune" class="text-4xl font-bold text-accent"></p>
            <p id="omikuji-overall" class="mx-auto mt-2 max-w-md font-mono text-sm leading-relaxed text-ink-soft"></p>
          </div>

          <div id="omikuji-line" class="mb-6 hidden">
            <div class="line-mock-body">
              <div class="line-mock-row">
                <div id="omikuji-line-avatar" class="line-mock-avatar"></div>
                <div class="line-mock-bubble">
                  <span id="omikuji-line-message"></span>
                </div>
              </div>
            </div>
          </div>

          <dl id="omikuji-detail" class="font-mono text-sm text-ink-soft"></dl>
        </div>
      </div>
    )}
  </section>

  <script
    is:inline
    define:vars={{ items: omikujiItems, fields: omikujiFields, messages: omikujiMessages }}
  >
    const intro = document.getElementById('omikuji-intro');
    const heading = document.getElementById('omikuji-heading');
    const button = document.getElementById('omikuji-draw');
    const result = document.getElementById('omikuji-result');
    const fortuneEl = document.getElementById('omikuji-fortune');
    const overallEl = document.getElementById('omikuji-overall');
    const detailEl = document.getElementById('omikuji-detail');
    const lineBox = document.getElementById('omikuji-line');
    const lineAvatar = document.getElementById('omikuji-line-avatar');
    const lineMessage = document.getElementById('omikuji-line-message');

    button?.addEventListener('click', () => {
      const item = items[Math.floor(Math.random() * items.length)];

      fortuneEl.textContent = item.fortune;
      overallEl.textContent = item.overall;
      detailEl.innerHTML = fields
        .map(({ key, label }) => {
          const value = item[key] || '—';
          return `<div class="omikuji-detail-row"><dt>${label}</dt><dd>${value}</dd></div>`;
        })
        .join('');

      const match = messages.find((m) => m.fortune === item.fortune);
      if (match) {
        if (match.imageUrl) {
          lineAvatar.style.backgroundImage = `url(${match.imageUrl})`;
          lineAvatar.textContent = '';
        } else {
          lineAvatar.style.backgroundImage = 'none';
          lineAvatar.textContent = '🔮';
        }
        lineMessage.textContent = match.message;
        lineBox.classList.remove('hidden');
      } else {
        lineBox.classList.add('hidden');
      }

      intro?.classList.add('hidden');
      heading.classList.remove('hidden');
      result.classList.remove('hidden');
      button.classList.add('hidden');
    });
  </script>
</BaseLayout>
