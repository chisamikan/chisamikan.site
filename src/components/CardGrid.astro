---
// Card.astro を並べるグリッドの共通ラッパー。画像は loading="lazy" のため、
// 表示直後は中身が空に見えることがある。画面内(付近)の画像が読み込まれるまで
// スピナーを重ねて隠すことで、その「空に見える瞬間」を目立たなくする。
// 待つ対象を画面内の画像に限定しているのは、スマートフォンなど1カラム表示で
// グリッドの縦幅が長くなる場合、画面外の(まだ表示されていない)カードの画像まで
// 待ってしまうと、実際に見えているカードの画像はとっくに表示済みなのに
// スピナーだけがいつまでも残るように見えてしまうため。
// タグ絞り込み等でページ側が表示更新を担う場合は managed を付け、
// このコンポーネントの自動初期化をスキップしてページ側スクリプトに委ねる
// (対象は data-card-grid-loading={id} のオーバーレイ要素)。
interface Props {
  id: string;
  class?: string;
  managed?: boolean;
}

const { id, class: gridClass = '', managed = false } = Astro.props;
---

<div class="relative">
  <div id={id} class={gridClass}>
    <slot />
  </div>
  <div
    data-card-grid-loading={id}
    data-managed={managed ? 'true' : undefined}
    class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center opacity-0 transition-opacity duration-300"
    role="status"
    aria-live="polite"
    aria-hidden="true"
  >
    <i class="fa-solid fa-spinner fa-spin text-4xl text-accent" aria-hidden="true"></i>
    <span class="sr-only">読み込み中</span>
  </div>
</div>

<script>
  import { watchImageLoading } from '../lib/imageLoading';

  // ページ内の CardGrid インスタンスのうち、ページ側スクリプトが表示制御しないもの
  // (data-managed が無いもの)だけ、ここで自動的にスピナー表示を行う。
  document.querySelectorAll<HTMLElement>('[data-card-grid-loading]:not([data-managed])').forEach((overlay) => {
    const gridId = overlay.dataset.cardGridLoading;
    const grid = gridId ? document.getElementById(gridId) : null;
    if (!grid) return;

    watchImageLoading(overlay, grid, (img) => {
      if (img.complete) return false;
      const rect = img.getBoundingClientRect();
      return rect.top < window.innerHeight && rect.bottom > 0;
    });
  });
</script>
