---
// プロフィールの内容はGit管理するためコード上に直接記述する
// (以前はNotionページから取得していたが、変更履歴をGitで追えるようにするため廃止)
import SnsLinks from './SnsLinks.astro';

interface Props {
  // トップページでは抜粋表示のため、Softwares/Skillsセクションを省略できるようにする
  showSkills?: boolean;
  // split: アイコンを左、名前・紹介文・SNSを右に置く2カラム(トップページ用。狭い画面では縦積み)
  layout?: 'center' | 'split';
}
const { showSkills = true, layout = 'center' } = Astro.props;

const bioLines = [
  'インターネット絵とデザインと文マン。要するに器用貧乏。',
  '同人サークル『Pt.Spoon』・『Satellite Galaxy』主催。',
];

const skills = [
  {
    label: 'Softwares',
    items: [
      { name: 'CLIP STUDIO PAINT', icon: 'fa-solid fa-palette' },
      { name: 'Adobe Photoshop', icon: 'fa-solid fa-camera' },
      { name: 'Adobe Illustrator', icon: 'fa-solid fa-paintbrush' },
      { name: 'Adobe InDesign', icon: 'fa-solid fa-book-open' },
	  { name: 'Adobe Premiere', icon: 'fa-solid fa-clapperboard' },
      { name: 'Adobe XD', icon: 'fa-solid fa-globe' },
      { name: 'Figma', icon: 'fa-brands fa-figma' },
      { name: 'Affinity', icon: 'fa-solid fa-paintbrush' },
      { name: 'Visual Studio Code', icon: 'fa-brands fa-visual-studio' },
    ],
  },
  {
    label: 'Skills',
    items: [
      { name: 'HTML', icon: 'fa-brands fa-html5' },
      { name: 'CSS', icon: 'fa-brands fa-css3' },
      { name: 'JavaScript', icon: 'fa-brands fa-js' },
      { name: 'Git', icon: 'fa-brands fa-git' },
      { name: 'Node.js', icon: 'fa-brands fa-node-js' },
      { name: 'React', icon: 'fa-brands fa-react' },
      { name: 'Vue.js', icon: 'fa-brands fa-vuejs' },
      { name: 'Astro', icon: 'fa-solid fa-globe' },
      { name: 'PHP', icon: 'fa-brands fa-php' },
    ],
  },
];
---

<!-- split: トップページ用。狭い画面でも左揃えの縦積み
  center: プロフィールページ用。狭い画面では中央揃えの縦積み、md以上ではsplitと同じく
  アイコンを左・本文を右に置く2カラムにする -->
{layout === 'split' ? (
  <div class="grid items-center gap-8 md:grid-cols-[auto_1fr] md:gap-14">
    <img
      src="/images/profile-icon.webp"
      alt="千紗みかん"
      width="192"
      height="192"
      class="h-28 w-28 rounded-full object-cover shadow-pin md:h-48 md:w-48"
    />
    <div>
      <h3 class="flex items-baseline gap-3 text-3xl font-bold text-ink sm:text-4xl">
        千紗みかん
        <span class="text-sm font-medium tracking-normal text-graphite">Chisa Mikan</span>
      </h3>
      <p class="mt-4 leading-relaxed text-ink/80">
        {bioLines.map((line, i) => (
          <>{i > 0 && <br />}{line}</>
        ))}
      </p>
      <SnsLinks align="start" />
    </div>
  </div>
) : (
<div class="prose-custom md:grid md:grid-cols-[auto_1fr] md:items-start md:gap-14 md:text-left">
  <img
    src="/images/profile-icon.webp"
    alt="千紗みかん"
    width="192"
    height="192"
    class="mx-auto h-24 w-24 rounded-full object-cover shadow-pin sm:h-32 sm:w-32 md:mx-0 md:h-48 md:w-48"
  />
  <div class="space-y-6">
    <div class="md:flex md:items-baseline md:gap-3">
      <h3 class="whitespace-pre-line font-display text-3xl font-semibold leading-snug text-ink sm:text-4xl md:font-bold">
        千紗みかん
      </h3>
      <p class="mt-1 font-mono text-sm text-graphite md:mt-0">Chisa Mikan</p>
    </div>
    <p class="leading-relaxed text-ink/80">
      {bioLines.map((line, i) => (
        <>{i > 0 && <br />}{line}</>
      ))}
    </p>
    <SnsLinks align="responsive" />
    {showSkills && (
    <div class="space-y-8">
      {skills.map((group) => (
        <div>
          <p class="text-center font-bold text-ink md:text-left">{group.label}</p>
          <ul class="mt-3 flex flex-wrap justify-center gap-1.5 md:justify-start">
            {group.items.map((item) => (
              <li class="glass-tag text-xs">
                {item.icon && <i class:list={[item.icon, 'mr-1']} aria-hidden="true"></i>}
                {item.name}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    )}
  </div>
</div>
)}
