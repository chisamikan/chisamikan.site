---
// プロフィールの内容はGit管理するためコード上に直接記述する
// (以前はNotionページから取得していたが、変更履歴をGitで追えるようにするため廃止)
import SnsLinks from './SnsLinks.astro';

const skills = [
  {
    label: 'Softwares',
    items: [
      { name: 'CLIP STUDIO PAINT', icon: 'fa-solid fa-palette' },
      { name: 'Adobe Photoshop', icon: 'fa-solid fa-camera' },
      { name: 'Adobe Illustrator', icon: 'fa-solid fa-paintbrush' },
      { name: 'Adobe InDesign', icon: 'fa-solid fa-book-open' },
	  { name: 'Adobe Premiere', icon: 'fa-solid fa-clapperboard' },
      { name: 'Adobe XD', icon: 'fa-solid fa-globe' },
      { name: 'Figma', icon: 'fa-brands fa-figma' },
      { name: 'Affinity', icon: 'fa-solid fa-paintbrush' },
      { name: 'Visual Studio Code', icon: 'fa-brands fa-visual-studio' },
    ],
  },
  {
    label: 'Skills',
    items: [
      { name: 'HTML', icon: 'fa-brands fa-html5' },
      { name: 'CSS', icon: 'fa-brands fa-css3' },
      { name: 'JavaScript', icon: 'fa-brands fa-js' },
      { name: 'Git', icon: 'fa-brands fa-git' },
      { name: 'Node.js', icon: 'fa-brands fa-node-js' },
      { name: 'React', icon: 'fa-brands fa-react' },
      { name: 'Vue.js', icon: 'fa-brands fa-vuejs' },
      { name: 'Astro', icon: 'fa-solid fa-globe' },
      { name: 'PHP', icon: 'fa-brands fa-php' },
    ],
  },
];
---

<div class="prose-custom space-y-6">
  <div class="first:mt-0">
    <img
      src="/images/profile-icon.webp"
      alt="千紗みかん"
      width="128"
      height="128"
      class="mx-auto h-24 w-24 rounded-full object-cover shadow-pin sm:h-32 sm:w-32"
    />
    <h3 class="whitespace-pre-line font-display text-3xl font-semibold leading-snug text-ink sm:text-4xl">
      千紗みかん
    </h3>
    <p class="mt-1 font-mono text-sm text-graphite">Chisa Mikan</p>
  </div>
  <p class="leading-relaxed text-ink/80">
    インターネット絵とデザインと文マン。要するに器用貧乏。<br>
	同人サークル『Pt.Spoon』・『Satellite Galaxy』主催。
  </p>
  <SnsLinks />
  <div class="space-y-8">
    {skills.map((group) => (
      <div>
        <p class="text-center font-bold text-ink">{group.label}</p>
        <ul class="mt-3 flex flex-wrap justify-center gap-1.5">
          {group.items.map((item) => (
            <li class="glass-tag text-xs">
              {item.icon && <i class:list={[item.icon, 'mr-1']} aria-hidden="true"></i>}
              {item.name}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</div>
