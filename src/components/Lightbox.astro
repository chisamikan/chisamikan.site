---
// ページ内に1つだけ配置する。サムネイル側は
// class="lightbox-trigger" data-full="{画像URL}" data-alt="{alt}" を付与するだけで連動する。
---

<dialog id="lightbox" class="lightbox-dialog">
  <button type="button" id="lightbox-close" aria-label="閉じる" class="lightbox-close">
    &times;
  </button>
  <img id="lightbox-img" src="" alt="" />
</dialog>

<style>
  .lightbox-dialog {
    max-width: min(90vw, 900px);
    max-height: 85vh;
    padding: 0;
    border: none;
    background: transparent;
    overflow: visible;
  }

  .lightbox-dialog::backdrop {
    background: rgba(34, 31, 27, 0.82);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .lightbox-dialog.is-open::backdrop {
    opacity: 1;
  }

  .lightbox-dialog img {
    display: block;
    max-width: min(90vw, 900px);
    max-height: 85vh;
    width: auto;
    height: auto;
    border-radius: 2px;
    box-shadow: 0 12px 32px -8px rgba(34, 31, 27, 0.5);
    cursor: zoom-out;
    transform: scale(0.85);
    opacity: 0;
    transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.28s ease;
  }

  .lightbox-dialog img.is-visible {
    transform: scale(1);
    opacity: 1;
  }

  .lightbox-close {
    position: absolute;
    top: -2.5rem;
    right: 0;
    width: 2rem;
    height: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    line-height: 1;
    color: #faf7f0;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .lightbox-close:hover {
    color: #0099ff;
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#lightbox');
  const img = document.querySelector<HTMLImageElement>('#lightbox-img');
  const closeBtn = document.querySelector<HTMLButtonElement>('#lightbox-close');

  function closeWithZoomOut() {
    if (!dialog || !img || !dialog.open) return;
    img.classList.remove('is-visible');
    dialog.classList.remove('is-open');
    const onEnd = (e: TransitionEvent) => {
      if (e.propertyName !== 'transform') return;
      img.removeEventListener('transitionend', onEnd);
      dialog.close();
    };
    img.addEventListener('transitionend', onEnd);
  }

  document.querySelectorAll<HTMLElement>('.lightbox-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      if (!dialog || !img) return;
      const full = trigger.dataset.full;
      if (!full) return;
      img.src = full;
      img.alt = trigger.dataset.alt ?? '';
      img.classList.remove('is-visible');
      dialog.classList.remove('is-open');
      dialog.showModal();
      // 初期状態(縮小・透明)を描画してからズームイン/背景フェードインさせる
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          img.classList.add('is-visible');
          dialog.classList.add('is-open');
        });
      });
    });
  });

  // 画像自体をタップしたらズームアウトして閉じる
  img?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeWithZoomOut();
  });

  // 背景(dialog自身)をクリックしたらズームアウトして閉じる
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) closeWithZoomOut();
  });
  closeBtn?.addEventListener('click', closeWithZoomOut);

  // Escキーでもズームアウトしてから閉じる
  dialog?.addEventListener('cancel', (e) => {
    e.preventDefault();
    closeWithZoomOut();
  });
</script>
