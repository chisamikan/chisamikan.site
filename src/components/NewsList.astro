---
import type { NewsFeedItem } from '../lib/news';
import { getCategoryMeta } from '../lib/news';

interface Props {
  items: NewsFeedItem[];
  // 0件の時の表示。カテゴリで絞り込んだページでは、そのカテゴリが空であることを伝える
  emptyText?: string;
}
const { items, emptyText = 'お知らせはまだありません。' } = Astro.props;
---

<!-- 見出し(SectionHeading)の直後に置かれたとき(トップのお知らせ)は、見出しの下の罫線が区切りを兼ねるため、
  一覧の上の区切り線を引かず、横線が2本続いて見えないようにする -->
{items.length > 0 ? (
  <ul class="border-y border-ink/10 divide-y divide-ink/10 [.heading-reveal+&]:border-t-0">
    {items.map((item) => {
      const meta = getCategoryMeta(item.category);
      const formattedDate = new Date(item.date)
        .toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
        .replaceAll('/', '.');
      const Wrapper = item.link ? 'a' : 'div';
      const linkProps = item.link
        ? {
            href: item.link,
            ...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {}),
          }
        : {};
      return (
        <li>
          <Wrapper
            {...linkProps}
            class:list={[
              // 狭い画面では日付とカテゴリを1行目に、タイトルを2行目に回す。
              // 行ごとに別のグリッドのため、カテゴリ列を中身なり(auto)にするとカテゴリ名の長さで
              // タイトルの左端がずれる。最長の「技術記事(Zenn)」が枠線込みで収まる固定幅で揃える
              'grid grid-cols-[auto_1fr] items-baseline gap-x-4 gap-y-1.5 py-5 sm:grid-cols-[6.5rem_8rem_1fr_auto]',
              item.link && 'no-external-icon group transition-opacity duration-150 active:opacity-60',
            ]}
          >
            <span class="font-num text-[13px] text-ink-soft">{formattedDate}</span>
            <span class="glass-tag justify-self-start whitespace-nowrap">
              <i class={`${meta.icon} mr-1`} aria-hidden="true"></i>
              {meta.label}
            </span>
            <span class:list={['col-span-full font-medium text-ink sm:col-span-1', item.link && 'transition-colors group-hover:text-accent-text']}>
              {item.title}
              {/* 外部リンクの印は右端ではなく、テキストの右隣に置く(全ページ共通の仕様) */}
              {item.external && (
                <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[0.8em]" aria-hidden="true"></i>
              )}
            </span>
            <span
              class:list={[
                'hidden text-sm text-ink/35 sm:block',
                item.link && 'transition-[color,transform] duration-200 ease-out group-hover:translate-x-1 group-hover:text-accent-text',
              ]}
              aria-hidden="true"
            >
              {item.link && <i class="fa-solid fa-chevron-right"></i>}
            </span>
          </Wrapper>
        </li>
      );
    })}
  </ul>
) : (
  <p class="text-sm text-graphite">{emptyText}</p>
)}
