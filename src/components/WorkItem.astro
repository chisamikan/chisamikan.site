---
import type { WorkItem } from '../lib/notion';
import WorkThumbnail from './WorkThumbnail.astro';

interface Props {
  item: WorkItem;
}
const { item } = Astro.props;

function formatPeriod(start: string | null, end: string | null) {
  const fmt = (d: string) =>
    new Date(d).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit' });
  if (!start) return '';
  return end ? `${fmt(start)} - ${fmt(end)}` : `${fmt(start)} -`;
}
---

<article class="relative border-l-2 border-indigo/30 py-6 pl-8">
  <span class="absolute -left-[7px] top-8 h-3 w-3 rounded-full border-2 border-indigo bg-paper"></span>

  <div class="flex gap-5">
    <WorkThumbnail item={item} class="paper-tilt w-20 shrink-0 sm:w-24" />

    <div class="min-w-0 flex-1">
      <p class="font-mono text-xs text-graphite">{formatPeriod(item.periodStart, item.periodEnd)}</p>
      <h3 class="mt-1 font-display text-xl font-semibold text-ink">{item.client}</h3>
      {item.role && <p class="mt-0.5 text-sm font-medium text-indigo">{item.role}</p>}

      {item.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {item.tags.map((tag) => (
            <li class="rounded-full border border-ink/15 px-2.5 py-0.5 font-mono text-[11px] text-ink/70">
              {tag}
            </li>
          ))}
        </ul>
      )}

      {item.url && (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-1.5 rounded-sm border border-ink/20 px-3.5 py-1.5 font-mono text-xs text-ink transition-colors hover:border-marker hover:text-marker"
        >
          詳細を見る
          <span aria-hidden="true">&#8599;</span>
        </a>
      )}
    </div>
  </div>
</article>
