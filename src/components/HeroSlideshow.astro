---
// ファーストビューの全画面イラストをスライドショー表示する。
// 画像が1枚のみの場合は静止画のまま(不要なアニメーションを避ける)。
interface Props {
  images: string[];
}

const { images } = Astro.props;
---

<div class="hero-slideshow absolute inset-0 h-full w-full">
  {images.map((src, i) => (
    <img
      src={src}
      alt="ファーストビューのイラスト"
      class={`hero-slide absolute inset-0 h-full w-full object-cover${i === 0 ? ' is-active' : ''}`}
      style={i === 0 ? undefined : 'opacity: 0;'}
      loading={i === 0 ? 'eager' : 'lazy'}
      fetchpriority={i === 0 ? 'high' : 'low'}
      decoding="async"
    />
  ))}
</div>

<!-- レンズフレア: グラデーションの円を重ねてゆっくり回転させるだけの演出。mix-blend-mode:overlayで下の写真と馴染ませる -->
<div class="lens-flare pointer-events-none absolute inset-0" aria-hidden="true">
  <div class="flare-circle gold top"></div>
  <div class="flare-circle blue bottom"></div>
  <div class="flare-circle pink top right"></div>
  <div class="flare-circle green top right"></div>
  <div class="flare-circle gray"></div>
</div>

<style>
  .hero-slide {
    transition: opacity 1.2s ease;
    transform: scale(1);
  }
  .hero-slide.is-active {
    animation: hero-zoom 6.2s ease-out forwards;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.hero-slideshow').forEach((container) => {
    const slides = container.querySelectorAll<HTMLImageElement>('.hero-slide');
    if (slides.length <= 1) return;

    let current = 0;
    setInterval(() => {
      const next = (current + 1) % slides.length;
      // 読み込みが終わっていない画像に切り替えると、その画像の遅い読み込み完了がLCPとして計測されてしまうため待つ
      if (!slides[next].complete) return;
      // current側はis-activeを外さない: 外すとズームが一瞬元に戻ってフェードアウトが不自然になる
      slides[current].style.opacity = '0';
      slides[next].style.opacity = '1';
      // クラスを一度外して再度付けることでズームアニメーションを最初から再生させる(この時点ではopacity:0で不可視)
      slides[next].classList.remove('is-active');
      void slides[next].offsetWidth;
      slides[next].classList.add('is-active');
      current = next;
    }, 5000);
  });
</script>
