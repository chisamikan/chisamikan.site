---
import type { ToolboxItem } from '../lib/notion';
import ToolboxThumbnail from './ToolboxThumbnail.astro';

interface Props {
  item: ToolboxItem;
  headingLevel?: 2 | 3;
}
const { item, headingLevel = 3 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="relative border-l-2 border-accent/30 py-6 pl-8">
  <span class="absolute -left-1.75 top-8 h-3 w-3 rounded-full border-2 border-accent bg-paper"></span>

  <div class="flex items-start gap-5">
    <ToolboxThumbnail item={item} class="w-20 shrink-0 sm:w-36" />

    <div class="min-w-0 flex-1">
      <Tag class="font-display text-xl font-semibold text-ink">{item.title}</Tag>
      {item.description && <p class="mt-1 text-sm text-ink/70">{item.description}</p>}

      {item.url && (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glass btn-glass-sm mt-4 hover:text-accent"
        >
          配布先
        </a>
      )}
    </div>
  </div>
</article>
