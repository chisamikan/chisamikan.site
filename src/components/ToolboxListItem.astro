---
import type { ToolboxItem } from '../lib/notion';
import TimelineEntry from './TimelineEntry.astro';
import Thumbnail from './Thumbnail.astro';

interface Props {
  item: ToolboxItem;
  headingLevel?: 2 | 3;
}
const { item, headingLevel = 3 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---

<TimelineEntry>
  <Thumbnail
    slot="thumbnail"
    imageUrl={item.imageUrl}
    label={`${item.title}の画像`}
    class="w-20 shrink-0 sm:w-36"
  />

  <Tag class="font-display text-xl font-semibold text-ink">{item.title}</Tag>
  {item.description && <p class="mt-1 text-sm text-ink/70">{item.description}</p>}

  {item.url && (
    <a
      href={item.url}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-glass btn-glass-sm mt-4 hover:text-accent"
    >
      配布先
    </a>
  )}
</TimelineEntry>
