---
import { nav } from '../lib/config';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<input type="checkbox" id="nav-toggle" class="peer hidden" />

<header id="site-header" class="sticky top-0 z-40 border-b border-glass-border bg-paper/70 shadow-glass backdrop-blur-xl">
  <div class="mx-auto max-w-5xl px-6 py-4">
    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-ink">
        <img src="/favicon.svg" alt="" width="24" height="24" class="h-6 w-6 rounded" />
        chisamikan.site
      </a>

      <div class="flex items-center gap-1 sm:gap-3">
        <nav aria-label="サイト内ナビゲーション" class="hidden lg:block">
          <ul class="flex items-center gap-1 font-mono text-xs uppercase tracking-wider sm:gap-2">
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'relative rounded px-2.5 py-1.5 transition-colors hover:text-accent sm:px-3',
                    isActive(item.href) ? 'text-accent' : 'text-ink/70',
                  ]}
                >
                  {item.label}
                  {isActive(item.href) && (
                    <span class="absolute inset-x-2 -bottom-0.5 h-0.5 bg-accent" aria-hidden="true"></span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <label
          for="nav-toggle"
          class="nav-icon-toggle flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded text-ink/70 transition-colors hover:text-accent lg:hidden"
          aria-label="メニューを開閉する"
        >
          <span class="nav-icon-bars">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </span>
        </label>

        <button
          type="button"
          aria-label="Dark Mode"
          aria-pressed="false"
          class="theme-toggle-btn hidden h-9 w-9 shrink-0 items-center justify-center rounded text-ink/70 transition-colors hover:text-accent lg:flex"
        >
          <!--
            FontAwesomeのCSSはTailwindのcascade layerの外側で読み込まれるため、
            レイヤーに属さないスタイルは常にレイヤー内のユーティリティより優先されてしまう
            (詳細: https://developer.mozilla.org/docs/Web/CSS/@layer)。
            .fa-regular が display: inline-block を無条件に指定してくるため、
            dark: の display 切り替えが効かず両方のアイコンが表示され続ける問題があった。
            important修飾子(末尾の!)で明示的に優先させる。
          -->
          <i class="fa-regular fa-moon dark:hidden!" aria-hidden="true"></i>
          <i class="fa-regular fa-sun hidden! dark:inline!" aria-hidden="true"></i>
        </button>
      </div>
    </div>
  </div>
</header>

<nav
  aria-label="サイト内ナビゲーション（モバイル）"
  class="mobile-nav-overlay pointer-events-none fixed inset-x-0 z-30 -translate-y-4 bg-paper/70 opacity-0 shadow-glass backdrop-blur-xl transition duration-300 ease-out peer-checked:pointer-events-auto peer-checked:translate-y-0 peer-checked:opacity-100 lg:hidden"
>
  <ul class="absolute left-1/2 top-1/2 flex w-full max-w-xs -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-2 px-6 font-mono text-xs uppercase tracking-wider">
    {nav.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'relative inline-block rounded px-3 py-2 transition-colors hover:text-accent',
            isActive(item.href) ? 'text-accent' : 'text-ink/70',
          ]}
        >
          {item.label}
        </a>
      </li>
    ))}
    <li>
      <button
        type="button"
        aria-label="Dark Mode"
        aria-pressed="false"
        class="theme-toggle-btn inline-flex items-center gap-2 rounded px-3 py-2 uppercase text-ink/70 transition-colors hover:text-accent"
      >
        <i class="fa-regular fa-moon dark:hidden!" aria-hidden="true"></i>
        <i class="fa-regular fa-sun hidden! dark:inline!" aria-hidden="true"></i>
        <span class="dark:hidden">Dark Mode</span>
        <span class="hidden dark:inline">Light Mode</span>
      </button>
    </li>
  </ul>
</nav>

<style>
  /* ヘッダーはオーバーレイの手前(z-40 > z-30)に重なって表示されるだけで、
     オーバーレイ自身の高さは top-0 のまま画面全体に及んでいた。そのため
     「展開エリアの中央」がヘッダーの裏に隠れた分だけ上にズレて見えていた。
     JSで実測したヘッダーの高さぶんだけ top を下げ、見えている範囲だけを
     基準に高さと中央揃えが計算されるようにする。 */
  .mobile-nav-overlay {
    top: var(--mobile-header-h, 4.5rem);
    height: calc(100dvh - var(--mobile-header-h, 4.5rem));
  }

  .nav-icon-bars {
    position: relative;
    display: block;
    width: 20px;
    height: 16px;
  }

  .nav-icon-bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: 0.25s ease-in-out;
  }

  .nav-icon-bars span:nth-child(1) {
    top: 0;
  }

  .nav-icon-bars span:nth-child(2),
  .nav-icon-bars span:nth-child(3) {
    top: 7px;
  }

  /* span:nth-child(3) exactly overlaps span:nth-child(2); with the
     semi-transparent ink color, showing both at once stacks the
     alpha and makes the middle bar look darker than the others. */
  .nav-icon-bars span:nth-child(3) {
    opacity: 0;
  }

  .nav-icon-bars span:nth-child(4) {
    top: 14px;
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(1) {
    top: 7px;
    width: 0;
    left: 50%;
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(2) {
    transform: rotate(45deg);
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(3) {
    opacity: 1;
    transform: rotate(-45deg);
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(4) {
    top: 7px;
    width: 0;
    left: 50%;
  }
</style>

<script>
  // モバイルの全画面メニューは、ヘッダーの裏に隠れた分を除いた「見えている範囲」を
  // 基準に高さ・中央揃えを計算したいので、ヘッダーの実測高さをCSS変数として公開する。
  // フォント読み込みや端末回転でヘッダーの高さが変わっても追従できるようResizeObserverで監視する。
  const siteHeader = document.getElementById('site-header');

  if (siteHeader && 'ResizeObserver' in window) {
    const updateHeaderHeight = () => {
      document.documentElement.style.setProperty('--mobile-header-h', `${siteHeader.offsetHeight}px`);
    };
    updateHeaderHeight();
    new ResizeObserver(updateHeaderHeight).observe(siteHeader);
  }

  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function applyState(isDark: boolean) {
    document.documentElement.classList.toggle('dark', isDark);
    toggles.forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', isDark ? 'Light Mode' : 'Dark Mode');
    });
  }

  applyState(document.documentElement.classList.contains('dark'));

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const isDark = !document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      applyState(isDark);
    });
  });

  // 明示的な選択(localStorageの保存値)が無い場合のみ、端末側の設定変更に追従する
  media.addEventListener('change', (event) => {
    if (localStorage.getItem('theme')) return;
    applyState(event.matches);
  });

  // 全画面メニュー表示中は背景をスクロールさせない。body { overflow: hidden } だと
  // iOSのSafariでツールバーの表示/非表示に伴う可視ビューポート高さの再計算が崩れ、
  // 固定オーバーレイの高さが画面全体を覆わなくなることがあるため、
  // スクロール位置を保持しつつ body ごと固定するiOS向けの定番手法を使う。
  const navToggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  let savedScrollY = 0;

  function setMenuOpen(isOpen: boolean) {
    if (!navToggle) return;
    navToggle.checked = isOpen;

    if (isOpen) {
      savedScrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
    } else {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      // html { scroll-behavior: smooth } の影響を受けると、トップから元の位置まで
      // アニメーションしながら戻ってしまい「再度スクロールされた」ように見えるため、
      // ここでは明示的にアニメーションなしで復元する。
      window.scrollTo({ top: savedScrollY, left: 0, behavior: 'instant' });
    }
  }

  navToggle?.addEventListener('change', () => setMenuOpen(navToggle.checked));

  // ページ内アンカー(例: /#news)はページ遷移が起きず全画面メニューが開いたままになるため、
  // タップ時に明示的にメニューを閉じる。別ページへのリンクはページ遷移がそのまま状態をリセットするので対象外。
  const mobileNavLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-overlay a');
  const currentPath = window.location.pathname;

  mobileNavLinks.forEach((link) => {
    const isSamePageAnchor = link.pathname === currentPath && link.hash !== '';
    if (!isSamePageAnchor) return;

    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
