---
import { nav } from '../lib/config';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-paper/85 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href="/" class="font-display text-xl font-semibold tracking-tight text-ink">
      Sketchbook<span class="text-marker">.</span>
    </a>

    <nav aria-label="サイト内ナビゲーション">
      <ul class="flex items-center gap-1 font-mono text-xs uppercase tracking-wider sm:gap-2">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative rounded px-2.5 py-1.5 transition-colors hover:text-marker sm:px-3',
                isActive(item.href) ? 'text-marker' : 'text-ink/70',
              ]}
            >
              {item.label}
              {isActive(item.href) && (
                <span class="absolute inset-x-2 -bottom-0.5 h-[2px] bg-marker" aria-hidden="true"></span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
