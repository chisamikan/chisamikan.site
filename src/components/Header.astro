---
import { nav } from '../lib/config';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<input type="checkbox" id="nav-toggle" class="peer hidden" />

<!-- ヘッダーは帯ではなく、ナビを浮かぶガラスの部品として右上に置く。
  背景を持たないため、トップページではファーストビューのイラストがそのまま裏に透ける -->
<header id="site-header" class="sticky top-0 z-40">
  <div class="flex items-center justify-end gap-3 px-4 py-4 sm:px-8 lg:px-12">
    <!-- 日本語名を併記すると横幅が増え、lg(1024px)では収まらないため、
      横並びのナビはxl以上で表示し、それ未満はメニューボタンに切り替える -->
    <nav aria-label="サイト内ナビゲーション" class="glass-float hidden rounded-full p-1.5 xl:block">
      <ul class="flex items-center gap-0.5">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'flex flex-col items-center rounded-full px-3.5 py-2 leading-tight transition-colors duration-150',
                isActive(item.href) ? 'bg-ink text-paper' : 'text-ink/70 hover:bg-ink/6 hover:text-ink',
              ]}
            >
              <span class="text-[15px] font-medium">{item.labelJa}</span>
              <span class="text-[10px] font-medium uppercase tracking-[0.12em] opacity-60">{item.label}</span>
            </a>
          </li>
        ))}
        <li>
          <button
            type="button"
            aria-label="Dark Mode"
            aria-pressed="false"
            class="theme-toggle-btn flex h-12 w-12 cursor-pointer items-center justify-center rounded-full text-ink/70 transition-colors duration-150 hover:bg-ink/6 hover:text-ink"
          >
            <!-- FontAwesomeのCSSはcascade layer外で読み込まれ常に優先されるため、
              .fa-regular の display: inline-block を dark: 切り替えで上書きできるよう
              important修飾子(末尾の!)で明示的に優先させる -->
            <i class="fa-regular fa-moon dark:hidden!" aria-hidden="true"></i>
            <i class="fa-regular fa-sun hidden! dark:inline!" aria-hidden="true"></i>
          </button>
        </li>
      </ul>
    </nav>

    <label
      for="nav-toggle"
      class="nav-icon-toggle glass-float flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full text-ink transition-transform duration-150 ease-out active:scale-[0.97] xl:hidden"
      aria-label="メニューを開閉する"
    >
      <span class="nav-icon-bars">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </span>
    </label>
  </div>
</header>

<nav
  aria-label="サイト内ナビゲーション（モバイル）"
  class="mobile-nav-overlay pointer-events-none fixed inset-x-0 z-30 -translate-y-4 bg-paper/80 opacity-0 backdrop-blur-xl transition duration-300 ease-out peer-checked:pointer-events-auto peer-checked:translate-y-0 peer-checked:opacity-100 xl:hidden"
>
  <!-- 区切り線を画面の横幅いっぱいに引くため、左右の余白はリスト側ではなく各行(リンク)に持たせる。
    行全体をリンクにしてタップできる範囲も広げる。表示中のページは、行の左端のアクセント色の線と
    文字色・ごく薄い色の敷きで示す -->
  <ul class="mobile-nav-list absolute inset-x-0 flex -translate-y-1/2 flex-col divide-y divide-ink/10 border-y border-ink/10">
    {nav.map((item) => (
      <li>
        <a
          href={item.href}
          aria-current={isActive(item.href) ? 'page' : undefined}
          class:list={[
            'relative flex items-baseline gap-3 px-8 py-2.5 leading-tight transition-colors duration-150 sm:px-12',
            isActive(item.href)
              ? 'bg-accent/8 text-accent before:absolute before:inset-y-0 before:left-0 before:w-1 before:bg-accent before:content-[""]'
              : 'text-ink/70 hover:text-ink',
          ]}
        >
          <span class="text-2xl font-semibold">{item.labelJa}</span>
          <span class="text-xs font-medium uppercase tracking-[0.12em] opacity-60">{item.label}</span>
        </a>
      </li>
    ))}
    <li>
      <button
        type="button"
        aria-label="Dark Mode"
        aria-pressed="false"
        class="theme-toggle-btn flex w-full cursor-pointer items-center gap-2 px-8 py-3.5 text-base text-ink/70 transition-colors duration-150 hover:text-ink sm:px-12"
      >
        <i class="fa-regular fa-moon dark:hidden!" aria-hidden="true"></i>
        <i class="fa-regular fa-sun hidden! dark:inline!" aria-hidden="true"></i>
        <span class="dark:hidden">Dark Mode</span>
        <span class="hidden dark:inline">Light Mode</span>
      </button>
    </li>
  </ul>
</nav>

<style>
  @reference "../styles/global.css";

  .mobile-nav-overlay {
    /* ヘッダーは背景を持たないため、オーバーレイをヘッダーの下から始めると
       上端に裏のページが帯状に覗いてしまう。画面全体を覆い、ヘッダー(z-40)はその上に重ねる */
    top: 0;
    height: 100dvh;
  }

  .mobile-nav-list {
    /* 項目の中央揃えは、ヘッダーに隠れない見えている範囲を基準にするため、
       JSで実測したヘッダー高さの半分だけ下にずらす。
       var()のフォールバック用コンマがscoped styleの@apply内では正しく処理できない
       (エスケープしても出力にバックスラッシュが残ってしまう)ため、プレーンCSSのまま残す */
    top: calc(50% + var(--mobile-header-h, 4.5rem) / 2);
  }

  /* 横向きで縦の表示領域が狭い端末では9項目の縦積みが画面に収まらないため、
     画面が低いときだけ横並び+折り返しにする */
  @media (max-height: 500px) and (orientation: landscape) {
    .mobile-nav-list {
      /* 横並びでは区切り線が項目の上に1本ずつ浮いて見えるため外す */
      @apply flex-row flex-wrap justify-start gap-y-2 gap-x-6 divide-y-0 border-y-0 px-8;
    }

    /* 横並びでは行の概念がないため、各項目の余白と表示中ページの左端の線をなくし、文字色だけで示す */
    .mobile-nav-list a,
    .mobile-nav-list .theme-toggle-btn {
      @apply px-0 py-1 bg-transparent before:hidden;
    }
  }

  .nav-icon-bars {
    @apply relative block w-5 h-4;
  }

  .nav-icon-bars span {
    @apply absolute left-0 w-full h-0.5 rounded-[2px] bg-current transition-all duration-[250ms] ease-in-out;
  }

  .nav-icon-bars span:nth-child(1) {
    @apply top-0;
  }

  .nav-icon-bars span:nth-child(2),
  .nav-icon-bars span:nth-child(3) {
    @apply top-[7px];
  }

  /* span:nth-child(3) は span:nth-child(2) と完全に重なるため、両方表示すると
     半透明色が重なって中央のバーだけ濃く見えてしまう */
  .nav-icon-bars span:nth-child(3) {
    @apply opacity-0;
  }

  .nav-icon-bars span:nth-child(4) {
    @apply top-[14px];
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(1) {
    @apply top-[7px] w-0 left-1/2;
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(2) {
    @apply rotate-45;
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(3) {
    @apply opacity-100 -rotate-45;
  }

  #nav-toggle:checked ~ header .nav-icon-bars span:nth-child(4) {
    @apply top-[7px] w-0 left-1/2;
  }
</style>

<script>
  // モバイルメニューの高さ計算用に、ヘッダーの実測高さをCSS変数として公開する。
  // フォント読み込みや端末回転での変化に追従できるようResizeObserverで監視する。
  const siteHeader = document.getElementById('site-header');

  if (siteHeader) {
    const updateHeaderHeight = () => {
      document.documentElement.style.setProperty('--mobile-header-h', `${siteHeader.offsetHeight}px`);
    };
    updateHeaderHeight();
    new ResizeObserver(updateHeaderHeight).observe(siteHeader);
  }

  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function applyState(isDark: boolean) {
    document.documentElement.classList.toggle('dark', isDark);
    toggles.forEach((toggle) => {
      toggle.setAttribute('aria-pressed', String(isDark));
      toggle.setAttribute('aria-label', isDark ? 'Light Mode' : 'Dark Mode');
    });
  }

  applyState(document.documentElement.classList.contains('dark'));

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const isDark = !document.documentElement.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      applyState(isDark);
    });
  });

  // 明示的な選択(localStorageの保存値)が無い場合のみ、端末側の設定変更に追従する
  media.addEventListener('change', (event) => {
    if (localStorage.getItem('theme')) return;
    applyState(event.matches);
  });

  // 全画面メニュー表示中は背景をスクロールさせない。body { overflow: hidden } だと
  // iOS Safariでツールバー表示/非表示時の可視ビューポート再計算が崩れるため、
  // スクロール位置を保持しつつ body ごと固定するiOS向けの手法を使う。
  const navToggle = document.getElementById('nav-toggle') as HTMLInputElement | null;
  let savedScrollY = 0;

  function setMenuOpen(isOpen: boolean) {
    if (!navToggle) return;
    navToggle.checked = isOpen;

    if (isOpen) {
      savedScrollY = window.scrollY;
      document.body.style.position = 'fixed';
      document.body.style.top = `-${savedScrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
    } else {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      // scroll-behavior: smooth の影響でアニメーションしながら戻ると
      // 「再度スクロールされた」ように見えるため、アニメーションなしで復元する。
      window.scrollTo({ top: savedScrollY, left: 0, behavior: 'instant' });
    }
  }

  navToggle?.addEventListener('change', () => setMenuOpen(navToggle.checked));

  // ページ内アンカー(例: /#news)はページ遷移が起きずメニューが開いたままになるため、
  // タップ時に明示的に閉じる。別ページへのリンクは遷移が状態をリセットするので対象外。
  const mobileNavLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-overlay a');
  const currentPath = window.location.pathname;

  mobileNavLinks.forEach((link) => {
    const isSamePageAnchor = link.pathname === currentPath && link.hash !== '';
    if (!isSamePageAnchor) return;

    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
