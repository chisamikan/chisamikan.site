---
import { nav } from '../lib/config';

const currentPath = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-white/40 bg-paper/70 shadow-glass backdrop-blur-xl">
  <div class="mx-auto max-w-5xl px-6 py-4">
    <input type="checkbox" id="nav-toggle" class="peer hidden" />

    <div class="flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 font-display text-xl font-semibold tracking-tight text-ink">
        <img src="/favicon.svg" alt="" width="24" height="24" class="h-6 w-6 rounded" />
        chisamikan.site
      </a>

      <nav aria-label="サイト内ナビゲーション" class="hidden sm:block">
        <ul class="flex items-center gap-1 font-mono text-xs uppercase tracking-wider sm:gap-2">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'relative rounded px-2.5 py-1.5 transition-colors hover:text-accent sm:px-3',
                  isActive(item.href) ? 'text-accent' : 'text-ink/70',
                ]}
              >
                {item.label}
                {isActive(item.href) && (
                  <span class="absolute inset-x-2 -bottom-0.5 h-[2px] bg-accent" aria-hidden="true"></span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <label
        for="nav-toggle"
        class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded text-ink/70 transition-colors hover:text-accent sm:hidden"
        aria-label="メニューを開閉する"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </label>
    </div>

    <nav aria-label="サイト内ナビゲーション（モバイル）" class="hidden peer-checked:block sm:hidden">
      <ul class="mt-4 flex flex-col items-start gap-1 font-mono text-xs uppercase tracking-wider">
        {nav.map((item) => (
          <li class="w-full">
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'relative block rounded px-2.5 py-2 transition-colors hover:text-accent',
                isActive(item.href) ? 'text-accent' : 'text-ink/70',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
