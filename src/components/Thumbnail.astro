---
interface Props {
  imageUrl: string | null;
  /** ライトボックスのdata-alt、及び「〜を拡大表示」のaria-labelに使う見出し(例: `${item.title}の表紙`) */
  label: string;
  class?: string;
  /** true の場合、外側のカードが枠を持つため縁取り・影・背景を付けない */
  bare?: boolean;
}
const { imageUrl, label, class: className = '', bare = false } = Astro.props;

const PLACEHOLDER = '/images/work-placeholder.svg';
const hasImage = Boolean(imageUrl);
const src = imageUrl ?? PLACEHOLDER;

// List.astro専用の枠スタイル(.thumbnail-frame/.thumbnail-frame-static)を使う。
// Card UI(.glass-card/.glass-panel)とは角丸の値が異なるため、CSSを共有しない
const frameClass = bare ? '' : 'thumbnail-frame';
const placeholderFrameClass = bare ? '' : 'thumbnail-frame-static';
---

{hasImage ? (
  <button
    type="button"
    class:list={['lightbox-trigger group relative block aspect-square overflow-hidden', frameClass, className]}
    data-full={src}
    data-alt={label}
    aria-label={`${label}を拡大表示`}
  >
    <img
      src={src}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover object-top transition-transform duration-300 will-change-transform scale-[1.02] group-hover:scale-105"
    />
  </button>
) : (
  <div
    class:list={['relative aspect-square overflow-hidden', placeholderFrameClass, className]}
    aria-hidden="true"
  >
    <img src={src} alt="" loading="lazy" class="h-full w-full object-cover object-top" />
  </div>
)}
