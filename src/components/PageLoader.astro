---
// 全ページ共通の初回表示ローディング演出。手描きのサインをペンでなぞるように、
// マスク用の線をstroke-dasharray/dashoffsetで少しずつ描画し、その下のサイン文字を
// 徐々に浮かび上がらせる。最初に見せる画像とフォントの読み込みを待ってフェードアウトする。
// 参考: https://knap.jp/blog/seisaku-fujii-20240521
// サインの文字の形(パスのデータ約43KB)は全ページのHTMLを重くするため別ファイルにし、
// 読み込み画面を出すとき(セッション中の初回)だけ取得する(取得はBaseLayoutの<head>で始める)。
// 届いてからペンでなぞる演出を始める
---

<div id="page-loader" class="page-loader" role="status" aria-live="polite">
  <span class="sr-only">読み込み中</span>
  <svg class="page-loader-signature" viewBox="0 0 1288 503" aria-hidden="true">
    <defs>
      <linearGradient id="page-loader-gradient" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" class="page-loader-gradient-stop-1"></stop>
        <stop offset="50%" class="page-loader-gradient-stop-2"></stop>
        <stop offset="100%" class="page-loader-gradient-stop-3"></stop>
      </linearGradient>
    </defs>
    <g id="page-loader-text" class="page-loader-text">
      <g transform="matrix(4.861111,0,0,4.861111,-38.452843,-391.917493)">
        <path id="page-loader-text-path"></path>
      </g>
    </g>
    <mask id="page-loader-mask" class="page-loader-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1288" height="503">
      <path
        class="page-loader-mask-path"
        pathLength="1000"
        d="M226.31,232.691C239.677,231.397 248.679,249.426 300.017,223.757C306.345,220.592 338.359,187.276 359.205,145.583C374.486,115.022 382.591,16.614 331.286,29.44C313.727,33.83 233.698,88.586 210.676,108.73C209.221,110.003 208.733,108.512 190.574,122.131C185.429,125.99 187.154,127.389 181.64,131.065C167.971,140.178 87.153,224.078 78.898,246.092C76.664,252.048 57.401,284.153 55.446,287.412C48.803,298.483 29.007,337.353 24.176,371.169C19.465,404.147 42.869,446.17 50.979,451.576C53.761,453.431 88.263,486.159 142.553,472.586C325.182,426.929 466.295,194.185 486.516,176.853C492.833,171.438 492.3,171.019 550.172,98.679C550.765,97.938 570.274,91.979 569.157,94.212C560.223,112.08 464.234,223.704 456.364,231.574C324.341,363.596 273.153,446.054 278.798,440.409C293.316,425.891 313.647,408.464 316.768,405.789C382.2,349.705 382.603,350.654 456.364,306.397C528.429,263.158 451.172,396.013 447.43,414.723C443.851,432.615 418.324,471.416 479.816,456.043C504.008,449.995 579.543,387.418 614.944,334.316C637.239,300.873 670.607,275.246 663.986,285.179C598.488,383.425 592.165,379.202 572.507,438.175C562.928,466.912 609.143,448.11 632.812,430.358C655.148,413.606 689.29,389.219 694.234,385.687C728.507,361.207 778.752,289.978 764.59,325.382C762.903,329.6 749.772,384.327 728.854,419.19C715.851,440.861 702.665,462.924 665.198,434.825C664.425,434.245 638.396,414.723 658.498,424.774C713.289,452.17 763.798,467.072 841.647,433.708C908.876,404.896 933.394,368.119 938.805,360.002C939.059,359.621 966.488,320.639 955.557,319.798C892.61,314.956 770.526,417.309 802.56,449.343C815.783,462.565 862.797,438.368 891.633,421.066C932.751,396.396 960.262,342.561 965.608,335.433C969.703,329.972 917.215,399.957 944.389,418.073C1089.578,514.866 1328.228,344.434 1280.535,272.894C1265.156,249.825 1213.899,179.519 1077.284,250.559C1017.798,281.492 1002.563,407.698 1072.817,414.723C1124.178,419.859 1150.305,422.625 1188.96,396.855C1223.165,374.052 1230.042,380.087 1260.433,325.382C1290.851,270.63 1230.943,164.127 1139.823,224.873C1138,226.088 1103.774,248.906 1134.239,251.676C1171.988,255.107 1286.312,194.182 1261.55,119.898C1249.789,84.616 1206.225,123.339 1196.778,142.233C1192.687,150.415 1180.748,167.591 1176.676,175.736C1158.414,212.261 1142.182,230.708 1136.473,219.29C1134.769,215.882 1140.751,211.74 1106.767,183.419C1089.459,168.996 1066.351,153.401 828.246,153.401C720.582,153.401 633.683,194.096 631.695,198.071C629.344,202.773 616.455,207.507 619.679,211.919C626.087,214.322 633.037,215.685 643.884,222.193C648.987,225.255 685.859,236.599 704.285,255.026C705.537,256.278 703.623,254.695 702.052,253.909"
      ></path>
    </mask>
  </svg>
</div>
<!-- 2ページ目以降は読み込み画面を出さないため、取得もしていない(window.__loaderSignature が無い) -->
<script is:inline>
  window.__loaderSignature?.then((d) => {
    document.getElementById('page-loader-text-path').setAttribute('d', d);
    document.getElementById('page-loader').classList.add('is-ready');
  }, () => {});
</script>

<style>
  @reference "../styles/global.css";

  .page-loader {
    @apply fixed inset-0 z-100 flex flex-col items-center justify-center gap-3 bg-paper transition-[opacity,visibility] duration-420 ease-[ease];
    /* スクリプトの読み込み失敗などで is-hidden が付かなくてもページが見られなくならないよう、
       一定時間たったらCSSだけで読み込み画面を消す */
    animation: page-loader-failsafe 0s 10s forwards;
  }

  @keyframes page-loader-failsafe {
    to {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }
  }

  /* セッション中2ページ目以降は出さない(BaseLayoutの<head>のスクリプトがhtmlに付与する) */
  :global(.skip-page-loader) .page-loader {
    @apply hidden;
  }

  .page-loader.is-hidden {
    @apply opacity-0 invisible pointer-events-none;
  }

  .page-loader-signature {
    @apply h-auto w-[min(260px,60vw)];
  }

  .page-loader-text {
    /* data URI ではなく要素IDの参照だが、Tailwindのmaskユーティリティは
       -webkit-mask を自動付与しないため、フォールバックを保つべくプレーンCSSのまま残す */
    mask: url(#page-loader-mask);
    -webkit-mask: url(#page-loader-mask);
  }

  .page-loader-text path {
    @apply fill-[url(#page-loader-gradient)];
  }

  /* stop-colorに対応するTailwindユーティリティが無いため、プレーンCSSのまま残す */
  .page-loader-gradient-stop-1 {
    stop-color: var(--color-accent);
  }

  .page-loader-gradient-stop-2 {
    stop-color: var(--color-accent-2);
  }

  .page-loader-gradient-stop-3 {
    stop-color: var(--color-accent);
  }

  .page-loader-mask-path {
    @apply fill-none stroke-white stroke-[30px];
    /* stroke-linecap/linejoin/dasharray/dashoffset、animationに対応する
       Tailwindユーティリティが無いため、この4行のみプレーンCSSのまま残す */
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000px;
    stroke-dashoffset: 1000px;
  }

  .page-loader.is-ready .page-loader-mask-path {
    animation: page-loader-draw 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes page-loader-draw {
    0% {
      stroke-dashoffset: 1000px;
    }
    55% {
      stroke-dashoffset: 0px;
    }
    100% {
      stroke-dashoffset: -1000px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader.is-ready .page-loader-mask-path {
      @apply animate-none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const loader = document.getElementById('page-loader');

  if (loader) {
    try {
      sessionStorage.setItem('chisamikan-page-loader-shown', '1');
    } catch {
      // sessionStorageが使えない場合は毎回表示するが、閲覧には支障がない
    }

    const MIN_VISIBLE_MS = 380;
    const shownAt = performance.now();

    const hide = () => {
      const elapsed = performance.now() - shownAt;
      const wait = Math.max(0, MIN_VISIBLE_MS - elapsed);
      window.setTimeout(() => {
        loader.classList.add('is-hidden');
      }, wait);
    };

    // 最初に見せる画像(fetchpriority="high"。トップのファーストビューの1枚)とフォントの読み込みを待って消す。
    // window の load はページ下部のカード画像まで待つため、待ち時間が長くなりすぎる。
    // フォントは待たないと、読み込み画面が消えた後に文字が描き直されてカクついて見える。
    // 回線が遅くなかなか届かない場合も、MAX_WAIT_MS で打ち切ってページを見せる
    const MAX_WAIT_MS = 3000;
    const loaded = (el: HTMLImageElement | HTMLLinkElement) =>
      new Promise((resolve) => {
        el.addEventListener('load', resolve, { once: true });
        el.addEventListener('error', resolve, { once: true });
      });
    const images = Array.from(document.querySelectorAll<HTMLImageElement>('img[fetchpriority="high"]'))
      .filter((img) => !img.complete)
      .map(loaded);
    // Google FontsのCSSは非同期で読み込む(BaseLayout)ため、CSSが届いてから、ページで使われている
    // フォントの読み込みを待つ。フォントの読み込みはレイアウトが決まってから始まるため、次の描画(レイアウト)が
    // 終わるのを待ってから document.fonts.ready を見る。offsetHeight 等でその場でレイアウトさせると、
    // ページ全体のレイアウトをスクリプトの中で強制する(強制リフロー)ことになり、メインスレッドを長く止める
    const fontCss = document.querySelector<HTMLLinkElement>('link[href^="https://fonts.googleapis.com/"]');
    const afterNextLayout = () => new Promise((resolve) => requestAnimationFrame(() => setTimeout(resolve)));
    const fonts = (fontCss && !fontCss.sheet ? loaded(fontCss) : Promise.resolve())
      .then(afterNextLayout)
      .then(() => document.fonts.ready);
    Promise.race([
      Promise.all([...images, fonts]),
      new Promise((resolve) => window.setTimeout(resolve, MAX_WAIT_MS)),
    ]).then(hide);

    // bfcacheで復元された場合はアニメーションなしで即座に非表示にする
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        loader.classList.add('is-hidden');
      }
    });
  }
</script>
