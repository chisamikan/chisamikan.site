<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background-color: rgb(var(--color-paper));
    background-image: radial-gradient(circle at 1px 1px, rgb(var(--color-ink) / 0.055) 1px, transparent 0);
    background-size: 22px 22px;
    transition: opacity 420ms ease, visibility 420ms ease;
  }

  .page-loader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .page-loader-signature {
    width: min(260px, 60vw);
    height: auto;
  }

  .page-loader-text {
    mask: url(#page-loader-mask);
    -webkit-mask: url(#page-loader-mask);
  }

  .page-loader-text path {
    fill: url(#page-loader-gradient);
  }

  .page-loader-gradient-stop-1 {
    stop-color: rgb(var(--color-accent));
  }

  .page-loader-gradient-stop-2 {
    stop-color: rgb(var(--color-accent-violet));
  }

  .page-loader-gradient-stop-3 {
    stop-color: rgb(var(--color-accent-rose));
  }

  .page-loader-mask-path {
    fill: none;
    stroke: #fff;
    stroke-width: 30px;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1000px;
    stroke-dashoffset: 1000px;
    animation: page-loader-draw 1.6s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes page-loader-draw {
    0% {
      stroke-dashoffset: 1000px;
    }
    55% {
      stroke-dashoffset: 0px;
    }
    100% {
      stroke-dashoffset: -1000px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-loader-mask-path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const loader = document.getElementById('page-loader');

  if (loader) {
    const MIN_VISIBLE_MS = 380;
    const shownAt = performance.now();

    const hide = () => {
      const elapsed = performance.now() - shownAt;
      const wait = Math.max(0, MIN_VISIBLE_MS - elapsed);
      window.setTimeout(() => {
        loader.classList.add('is-hidden');
      }, wait);
    };

    if (document.readyState === 'complete') {
      hide();
    } else {
      window.addEventListener('load', hide, { once: true });
    }

    // bfcacheで復元された場合はアニメーションなしで即座に非表示にする
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) {
        loader.classList.add('is-hidden');
      }
    });
  }
</script>
