---
import MarkerUnderline from './MarkerUnderline.astro';

interface Props {
  eyebrow?: string;
  title: string;
  color?: 'marker' | 'indigo';
}
const { eyebrow, title, color = 'marker' } = Astro.props;
---

<div class="mb-10">
  {eyebrow && (
    <p class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-graphite">{eyebrow}</p>
  )}
  <h2 class="marker-heading text-3xl font-semibold sm:text-4xl">
    {title}
    <MarkerUnderline color={color} />
  </h2>
</div>
