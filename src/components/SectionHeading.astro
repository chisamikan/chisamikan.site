---
interface Props {
  eyebrow?: string;
  title: string;
  level?: 1 | 2;
}
const { eyebrow, title, level = 2 } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2';
---

<div class="mb-10 text-center">
  {eyebrow && (
    <p class="mb-2 font-mono text-xs uppercase tracking-[0.2em] text-graphite">{eyebrow}</p>
  )}
  <Tag class="heading-lines before:border-ink after:border-ink text-3xl font-semibold sm:text-4xl">
    {title}
  </Tag>
</div>
