---
import type { NewsFeedItem } from '../lib/news';

interface Props {
  item: NewsFeedItem;
}
const { item } = Astro.props;

const formattedDate = item.date
  ? new Date(item.date).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })
  : null;

// 文字数に関わらず流れる速さ(px/秒)が揃って見えるよう、日付+タイトルの長さから再生時間を概算する
const duration = Math.min(30, Math.max(10, (item.title.length + (formattedDate?.length ?? 0)) * 0.35));

// リンクが無い(URL未設定の手動投稿)場合は、お知らせ一覧へ案内する
const href = item.link ?? '/news';
const isExternal = Boolean(item.link && item.external);
---

<!-- ファーストビューに浮かべる「NEW」の札。札全体を1つのリンクにし、日付+タイトルだけを流す -->
<a
  href={href}
  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
  class="news-ticker glass-float no-external-icon flex w-full items-center gap-2.5 rounded-full py-2 pl-2 pr-4 text-[13px] text-ink transition-transform duration-150 ease-out active:scale-[0.97] sm:w-md"
>
  <span class="shrink-0 rounded-full bg-accent-strong px-2.5 py-1 text-[11px] font-semibold tracking-wider text-on-accent">NEW</span>
  <span class="news-ticker-viewport min-w-0 flex-1 overflow-hidden">
    <span class="news-ticker-track flex w-max" style={`animation-duration: ${duration}s;`}>
      <span class="news-ticker-copy shrink-0 whitespace-nowrap pr-16">
        {formattedDate && <time datetime={item.date} class="mr-2 font-num text-xs text-ink/60">{formattedDate}</time>}
        {item.title}
        {/* 外部リンクの印は右端ではなく、テキストの右隣に置く(全ページ共通の仕様) */}
        {isExternal && <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[0.8em]" aria-hidden="true"></i>}
      </span>
      <span class="news-ticker-copy shrink-0 whitespace-nowrap pr-16" aria-hidden="true">
        {formattedDate && <span class="mr-2 font-num text-xs text-ink/60">{formattedDate}</span>}
        {item.title}
        {isExternal && <i class="fa-solid fa-arrow-up-right-from-square ml-1 text-[0.8em]"></i>}
      </span>
    </span>
  </span>
  <i class="fa-solid fa-chevron-right shrink-0 text-[0.85em] text-ink/50" aria-hidden="true"></i>
</a>

<style>
  @reference "../styles/global.css";

  /* タイトルを2つ並べて配置し、自身の50%(=コピー1個分)だけ動かすことで
     継ぎ目のない無限ループに見せる(電光掲示板と同じ仕組み) */
  .news-ticker-track {
    animation-name: news-ticker-scroll;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  /* ホバー中は読めるよう一時停止する */
  .news-ticker:hover .news-ticker-track {
    animation-play-state: paused;
  }

  @keyframes news-ticker-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-ticker-track {
      @apply animate-none transform-none;
    }

    .news-ticker-copy:nth-child(2) {
      @apply hidden;
    }
  }
</style>
