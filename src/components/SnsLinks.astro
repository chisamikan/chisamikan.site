---
import { snsLinks } from '../lib/config';
import MisskeyIcon from './icons/MisskeyIcon.astro';

interface Props {
  // start: 左寄せ(トップページのプロフィール2カラム用)
  // responsive: 狭い画面では中央、md以上では左寄せ(プロフィールページ用)
  align?: 'center' | 'start' | 'responsive';
}
const { align = 'center' } = Astro.props;

const alignClass = {
  center: 'mt-8 justify-center',
  start: 'mt-6 justify-start',
  responsive: 'mt-8 justify-center md:justify-start',
}[align];
---

<div class:list={['flex flex-wrap gap-3', alignClass]}>
  {snsLinks.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.label}
      title={link.label}
      class="no-external-icon inline-flex h-10 w-10 items-center justify-center rounded-full border border-glass-border bg-glass text-base text-ink shadow-glass backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-glass-md hover:text-accent hover:shadow-glass-lg"
    >
      {link.icon === 'custom:misskey' ? (
        <MisskeyIcon />
      ) : (
        <i class:list={[link.icon]} aria-hidden="true"></i>
      )}
    </a>
  ))}
</div>
