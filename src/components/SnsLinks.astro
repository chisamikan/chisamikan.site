---
import { snsLinks } from '../lib/config';
import MisskeyIcon from './icons/MisskeyIcon.astro';
---

<div class="mt-8 flex flex-wrap justify-center gap-3">
  {snsLinks.map((link) => (
    <a
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={link.label}
      title={link.label}
      class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/40 bg-white/25 text-base text-ink shadow-glass backdrop-blur-xl transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/40 hover:bg-white/40 hover:text-accent hover:shadow-glass-lg"
    >
      {link.icon === 'custom:misskey' ? (
        <MisskeyIcon />
      ) : (
        <i class:list={[link.icon]} aria-hidden="true"></i>
      )}
    </a>
  ))}
</div>
