---
import type { NovelItem } from '../lib/notion';

interface Props {
  item: NovelItem;
  headingLevel?: 2 | 3;
}
const { item, headingLevel = 3 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
const PLACEHOLDER = '/images/work-placeholder.svg';
const hasImage = Boolean(item.imageUrl);
const src = item.imageUrl ?? PLACEHOLDER;
---

<a
  href={`/novels#novel-${item.id}`}
  class="glass-card glass-panel group flex h-full flex-col overflow-hidden"
>
  <div class="relative aspect-square w-full overflow-hidden bg-paper-dim">
    <img
      src={src}
      alt={hasImage ? item.title : ''}
      loading="lazy"
      class:list={[
        'h-full w-full object-cover',
        hasImage && 'transition-transform duration-300 group-hover:scale-105',
      ]}
    />
  </div>

  <div class="glass-card-body">
    <Tag class="font-display text-lg font-medium leading-snug text-ink">{item.title}</Tag>
    {item.description && (
      <p class="mt-1 line-clamp-2 whitespace-pre-line text-sm text-ink/70">{item.description}</p>
    )}

    {item.tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-3">
        {item.tags.map((tag) => (
          <li class="glass-tag">
            {tag}
          </li>
        ))}
      </ul>
    )}
  </div>
</a>
