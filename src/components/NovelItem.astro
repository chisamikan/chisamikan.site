---
import type { NovelItem } from '../lib/notion';
import NovelThumbnail from './NovelThumbnail.astro';

interface Props {
  item: NovelItem;
  headingLevel?: 2 | 3;
}
const { item, headingLevel = 3 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---

<article id={`novel-${item.id}`} class="relative scroll-mt-24 border-l-2 border-accent/30 py-6 pl-8">
  <span class="absolute -left-1.75 top-8 h-3 w-3 rounded-full border-2 border-accent bg-paper"></span>

  <div class="flex items-start gap-5">
    <NovelThumbnail item={item} class="w-20 shrink-0 sm:w-36" />

    <div class="min-w-0 flex-1">
      {item.tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {item.tags.map((tag) => (
            <li class="glass-tag">
              {tag}
            </li>
          ))}
        </ul>
      )}

      <Tag class:list={['font-display text-xl font-semibold text-ink', item.tags.length > 0 && 'mt-2']}>
        {item.title}
      </Tag>
      {item.description && (
        <p class="mt-1 whitespace-pre-line text-sm text-ink/70">{item.description}</p>
      )}

      {(item.kakuyomuUrl || item.pixivUrl || item.shopUrl) && (
        <div class="mt-4 flex flex-wrap gap-2">
          {item.kakuyomuUrl && (
            <a
              href={item.kakuyomuUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-glass btn-glass-sm hover:text-accent"
            >
              カクヨムで読む
            </a>
          )}
          {item.pixivUrl && (
            <a
              href={item.pixivUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-glass btn-glass-sm hover:text-accent"
            >
              pixivで読む
            </a>
          )}
          {item.shopUrl && (
            <a
              href={item.shopUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-glass btn-glass-sm hover:text-accent"
            >
              通販はこちら
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</article>
