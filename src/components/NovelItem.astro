---
import type { NovelItem } from '../lib/notion';
import TimelineEntry from './TimelineEntry.astro';
import Thumbnail from './Thumbnail.astro';

interface Props {
  item: NovelItem;
  headingLevel?: 2 | 3;
}
const { item, headingLevel = 3 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
---

<TimelineEntry id={`novel-${item.id}`} class="scroll-mt-24">
  <Thumbnail
    slot="thumbnail"
    imageUrl={item.imageUrl}
    label={`${item.title}の表紙`}
    class="w-20 shrink-0 sm:w-36"
  />

  {item.tags.length > 0 && (
    <ul class="flex flex-wrap gap-1.5">
      {item.tags.map((tag) => (
        <li class="glass-tag">
          {tag}
        </li>
      ))}
    </ul>
  )}

  <Tag class:list={['font-display text-xl font-semibold text-ink', item.tags.length > 0 && 'mt-2']}>
    {item.title}
  </Tag>
  {item.description && (
    <p class="mt-1 whitespace-pre-line text-sm text-ink/70">{item.description}</p>
  )}

  {(item.kakuyomuUrl || item.pixivUrl || item.shopUrl) && (
    <div class="mt-4 flex flex-wrap gap-2">
      {item.kakuyomuUrl && (
        <a
          href={item.kakuyomuUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glass btn-glass-sm hover:text-accent"
        >
          カクヨムで読む
        </a>
      )}
      {item.pixivUrl && (
        <a
          href={item.pixivUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glass btn-glass-sm hover:text-accent"
        >
          pixivで読む
        </a>
      )}
      {item.shopUrl && (
        <a
          href={item.shopUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-glass btn-glass-sm hover:text-accent"
        >
          通販はこちら
        </a>
      )}
    </div>
  )}
</TimelineEntry>
