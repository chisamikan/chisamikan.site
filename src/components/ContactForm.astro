---
const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<form id="contact-form" class="space-y-6" novalidate>
  <div>
    <label for="name" class="mb-1.5 block font-mono text-xs uppercase tracking-wide text-graphite">
      お名前 <span class="text-marker">*</span>
    </label>
    <input
      id="name"
      name="name"
      type="text"
      required
      autocomplete="name"
      class="w-full rounded-sm border border-ink/20 bg-white px-3.5 py-2.5 text-ink outline-none transition-colors focus:border-indigo"
    />
  </div>

  <div>
    <label for="email" class="mb-1.5 block font-mono text-xs uppercase tracking-wide text-graphite">
      メールアドレス <span class="text-marker">*</span>
    </label>
    <input
      id="email"
      name="email"
      type="email"
      required
      autocomplete="email"
      class="w-full rounded-sm border border-ink/20 bg-white px-3.5 py-2.5 text-ink outline-none transition-colors focus:border-indigo"
    />
  </div>

  <div>
    <label for="message" class="mb-1.5 block font-mono text-xs uppercase tracking-wide text-graphite">
      お問い合わせ内容 <span class="text-marker">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows="6"
      required
      class="w-full rounded-sm border border-ink/20 bg-white px-3.5 py-2.5 text-ink outline-none transition-colors focus:border-indigo"
    ></textarea>
  </div>

  <!-- ハニーポット: スパム対策(人には見えないがボットは埋めてしまう)。サーバー側でも検証する -->
  <div class="hidden" aria-hidden="true">
    <label for="company">Company</label>
    <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <!-- タイムトラップ: フォーム表示時刻をJSで記録し、極端に早い送信をスパムとみなす -->
  <input type="hidden" id="loaded-at" name="loadedAt" value="" />

  {turnstileSiteKey && (
    <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
  )}

  <button
    type="submit"
    id="contact-submit"
    class="rounded-sm bg-ink px-6 py-2.5 font-mono text-sm text-paper transition-transform hover:-translate-y-0.5 disabled:cursor-not-allowed disabled:opacity-50 disabled:hover:translate-y-0"
  >
    送信する
  </button>

  <p id="form-status" role="status" class="font-mono text-sm"></p>
</form>

{turnstileSiteKey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const submitBtn = document.querySelector<HTMLButtonElement>('#contact-submit');
  const loadedAtInput = document.querySelector<HTMLInputElement>('#loaded-at');
  const turnstileWidget = document.querySelector<HTMLElement>('.cf-turnstile');

  // フォームが実際に表示された時刻を記録する(タイムトラップ用)。
  // JSを実行しない単純なボットは、この値が空のまま送信することになる。
  if (loadedAtInput) {
    loadedAtInput.value = String(Date.now());
  }

  function showError(message: string) {
    if (!status) return;
    status.textContent = message;
    status.className = 'font-mono text-sm text-marker-dark';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status) return;

    const data = Object.fromEntries(new FormData(form).entries());

    // ハニーポットに値が入っていたらスパムとみなし、成功したように見せて何もしない
    if (data.company) {
      status.textContent = '送信しました。ありがとうございます。';
      status.className = 'font-mono text-sm text-indigo';
      form.reset();
      return;
    }

    // Turnstileウィジェットがある場合、認証トークンを取得できているか送信時に確認する。
    // (ボタンを強制的に無効化する方式だと、トークンの自動更新が間に合わなかった際に
    //  ボタンが押せないまま固まって見えてしまうため、送信時チェックのみに留めている)
    const turnstileToken = (data['cf-turnstile-response'] as string) ?? '';
    if (turnstileWidget && !turnstileToken) {
      showError('認証を確認できませんでした。数秒待ってからもう一度お試しください。');
      return;
    }

    submitBtn?.setAttribute('disabled', 'true');
    status.textContent = '送信中です…';
    status.className = 'font-mono text-sm text-graphite';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.name,
          email: data.email,
          message: data.message,
          loadedAt: data.loadedAt,
          turnstileToken,
        }),
      });

      if (res.ok) {
        status.textContent = '送信しました。ありがとうございます。折り返しご連絡いたします。';
        status.className = 'font-mono text-sm text-indigo';
        form.reset();
        if (loadedAtInput) loadedAtInput.value = String(Date.now());
      } else {
        const body = await res.json().catch(() => ({}));
        if (body.error === 'turnstile_missing' || body.error === 'turnstile_failed') {
          showError('認証に失敗しました。もう一度お試しください。');
        } else if (body.error === 'invalid_email') {
          showError('メールアドレスの形式をご確認ください。');
        } else if (body.error === 'missing_fields') {
          showError('未入力の項目があります。ご確認ください。');
        } else if (body.error === 'server_error') {
          // 原因調査用: Notion API等の実際のエラー内容と診断情報を表示する。
          // 原因が判明し安定稼働したら、この分岐は削除して構いません。
          const diag = body.diagnostics ? ` / diag: ${JSON.stringify(body.diagnostics)}` : '';
          showError(
            body.detail
              ? `送信に失敗しました。(詳細: ${body.detail}${diag})`
              : '送信に失敗しました。時間をおいて再度お試しください。'
          );
        } else {
          showError('送信に失敗しました。時間をおいて再度お試しください。');
        }
      }
    } catch {
      showError('送信に失敗しました。通信環境をご確認のうえ再度お試しください。');
    } finally {
      // Turnstileのトークンは1回のみ有効なため、次回送信に備えてウィジェットをリセットする
      (window as any).turnstile?.reset();
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
