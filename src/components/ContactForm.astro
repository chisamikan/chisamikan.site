---
import { CONTACT_LIMITS } from '../lib/contactLimits';

const turnstileSiteKey = import.meta.env.TURNSTILE_SITE_KEY;
---

<form id="contact-form" class="space-y-6 text-left" novalidate>
  <div>
    <label for="name" class="mb-1.5 block text-sm font-medium text-ink">
      お名前 <span class="text-accent-text">*</span>
    </label>
    <input
      id="name"
      name="name"
      type="text"
      required
      maxlength={CONTACT_LIMITS.name}
      autocomplete="name"
      class="glass-input"
    />
  </div>

  <div>
    <label for="email" class="mb-1.5 block text-sm font-medium text-ink">
      メールアドレス <span class="text-accent-text">*</span>
    </label>
    <input
      id="email"
      name="email"
      type="email"
      required
      maxlength={CONTACT_LIMITS.email}
      autocomplete="email"
      class="glass-input"
    />
  </div>

  <div>
    <label for="message" class="mb-1.5 block text-sm font-medium text-ink">
      お問い合わせ内容 <span class="text-accent-text">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows="6"
      required
      maxlength={CONTACT_LIMITS.message}
      aria-describedby="message-count"
      class="glass-textarea"
    ></textarea>
    <!-- 入力のたびに読み上げられないよう、残り文字数の表示は aria-live にしない -->
    <p id="message-count" class="mt-1 text-right font-num text-xs tabular-nums text-graphite">
      0 / {CONTACT_LIMITS.message}
    </p>
  </div>

  <!-- ハニーポット: スパム対策(人には見えないがボットは埋めてしまう)。サーバー側でも検証する -->
  <div class="hidden" aria-hidden="true">
    <label for="company">Company</label>
    <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <!-- タイムトラップ: フォーム表示時刻をJSで記録し、極端に早い送信をスパムとみなす -->
  <input type="hidden" id="loaded-at" name="loadedAt" value="" />

  <div class="flex items-start gap-2">
    <input
      id="privacy-consent"
      name="privacyConsent"
      type="checkbox"
      required
      class="glass-checkbox"
    />
    <label for="privacy-consent" class="text-sm text-ink">
      <a href="/privacy" target="_blank" rel="noopener noreferrer" class="underline transition-colors hover:text-accent-text">
        プライバシーポリシー
      </a>
      に同意する <span class="text-accent-text">*</span>
    </label>
  </div>

  {turnstileSiteKey && (
    <div class="flex justify-center">
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>
    </div>
  )}

  <div class="text-center">
    <button
      type="submit"
      id="contact-submit"
      class="group btn-glass btn-glass-accent px-6 disabled:cursor-not-allowed disabled:opacity-50 btn-wide"
    >
      <!-- 送信中はボタンが disabled になるので、表示の切り替えはCSSだけで行う -->
      <span class="inline-flex items-center gap-1.5 group-disabled:hidden">送信する<i class="fa-solid fa-paper-plane" aria-hidden="true"></i></span>
      <span class="hidden items-center gap-1.5 group-disabled:inline-flex"><i class="fa-solid fa-spinner fa-spin" aria-hidden="true"></i>送信中……</span>
    </button>
  </div>

  <p id="form-status" role="status" class="text-sm text-center"></p>
</form>

<!-- 送信完了画面。自動返信メールは送らないため、送信内容の控えはこの画面で渡す -->
<section
  id="contact-complete"
  hidden
  tabindex="-1"
  aria-labelledby="contact-complete-title"
  class="space-y-6 rounded-lg border border-glass-border-subtle bg-surface p-6 text-left shadow-card outline-none"
>
  <div class="text-center">
    <h2 id="contact-complete-title" class="text-base font-semibold text-accent-text">
      <i class="fa-solid fa-circle-check pr-1" aria-hidden="true"></i>送信しました
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-ink-soft">
      5日以内にご返信します。<br />
      返信が届かない場合は、迷惑メールフォルダもご確認ください。
    </p>
    <!-- 予備の連絡先はAPIの応答でのみ受け取り、公開ページのHTMLには含めない -->
    <p id="complete-fallback" hidden class="mt-2 text-sm leading-relaxed text-ink-soft">
      それでも届かない場合は、下記の控えでメールアドレスに誤りがないかご確認のうえ、<a
        id="complete-fallback-link"
        class="text-accent-text underline underline-offset-4 transition-colors hover:text-ink"
      ></a>までご連絡ください。
    </p>
    <p class="mt-2 text-xs leading-relaxed text-ink-soft">
      ※サービスのご提案や一斉送信と思われるメッセージなど、内容によっては返信できない場合がございますので、予めご了承ください。
    </p>
  </div>

  <div>
    <p class="mb-3 text-sm text-ink-soft">送信内容の控えが必要な場合は、コピーして保存してください。</p>
    <dl class="space-y-4 rounded-md border border-glass-border-subtle p-4 text-sm">
      <div>
        <dt class="text-xs uppercase tracking-wide text-graphite">お名前</dt>
        <dd id="complete-name" class="mt-1 text-ink wrap-anywhere"></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-graphite">メールアドレス</dt>
        <dd id="complete-email" class="mt-1 text-ink wrap-anywhere"></dd>
      </div>
      <div>
        <dt class="text-xs uppercase tracking-wide text-graphite">お問い合わせ内容</dt>
        <dd id="complete-message" class="mt-1 max-h-80 overflow-y-auto overscroll-contain whitespace-pre-wrap text-ink wrap-anywhere"></dd>
      </div>
    </dl>
  </div>

  <div class="text-center">
    <button type="button" id="complete-copy" class="btn-glass btn-glass-accent btn-wide px-6">
      <i class="fa-solid fa-copy" aria-hidden="true"></i>内容をコピー
    </button>
  </div>
  <p id="complete-copy-status" role="status" class="text-center text-xs"></p>
</section>

{turnstileSiteKey && (
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  import { CONTACT_LIMITS } from '../lib/contactLimits';

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = document.querySelector<HTMLParagraphElement>('#form-status');
  const submitBtn = document.querySelector<HTMLButtonElement>('#contact-submit');
  const loadedAtInput = document.querySelector<HTMLInputElement>('#loaded-at');
  const turnstileWidget = document.querySelector<HTMLElement>('.cf-turnstile');
  const messageInput = document.querySelector<HTMLTextAreaElement>('#message');
  const messageCount = document.querySelector<HTMLParagraphElement>('#message-count');

  // 残り文字数の表示。value.length はブラウザの maxlength と同じ数え方(改行は1文字)になる
  function updateMessageCount() {
    if (!messageInput || !messageCount) return;
    const length = messageInput.value.length;
    messageCount.textContent = `${length} / ${CONTACT_LIMITS.message}`;
    messageCount.classList.toggle('text-accent-text', length >= CONTACT_LIMITS.message);
  }
  messageInput?.addEventListener('input', updateMessageCount);
  // 戻る操作などでブラウザが入力内容を復元した場合にも表示を合わせる
  updateMessageCount();

  // フォームが実際に表示された時刻を記録する(タイムトラップ用)。
  // JSを実行しない単純なボットは、この値が空のまま送信することになる。
  if (loadedAtInput) {
    loadedAtInput.value = String(Date.now());
  }

  function showError(message: string) {
    if (!status) return;
    status.textContent = message;
    status.className = 'text-sm text-red-600';
  }

  // --- 送信完了画面 ---
  const complete = document.querySelector<HTMLElement>('#contact-complete');
  const completeName = document.querySelector<HTMLElement>('#complete-name');
  const completeEmail = document.querySelector<HTMLElement>('#complete-email');
  const completeMessage = document.querySelector<HTMLElement>('#complete-message');
  const copyBtn = document.querySelector<HTMLButtonElement>('#complete-copy');
  const copyStatus = document.querySelector<HTMLParagraphElement>('#complete-copy-status');

  interface SentContent {
    name: string;
    email: string;
    message: string;
  }
  let sentContent: SentContent | null = null;

  // 連投を促さないよう、完了画面からフォームに戻る導線は設けない
  function showComplete(content: SentContent, fallbackEmail: string | undefined) {
    if (!form || !complete) return;
    sentContent = content;
    // 入力内容はHTMLとして解釈させないよう、必ず textContent で表示する
    if (completeName) completeName.textContent = content.name;
    if (completeEmail) completeEmail.textContent = content.email;
    if (completeMessage) completeMessage.textContent = content.message;
    const fallback = document.querySelector<HTMLParagraphElement>('#complete-fallback');
    const fallbackLink = document.querySelector<HTMLAnchorElement>('#complete-fallback-link');
    if (fallback && fallbackLink && fallbackEmail) {
      fallbackLink.textContent = fallbackEmail;
      fallbackLink.href = `mailto:${fallbackEmail}?subject=${encodeURIComponent('お問い合わせフォームについて')}`;
      fallback.hidden = false;
    }
    form.hidden = true;
    complete.hidden = false;
    // 画面の読み上げ・キーボード操作の起点を完了画面に移す
    complete.focus();
    complete.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  copyBtn?.addEventListener('click', async () => {
    if (!sentContent || !copyStatus) return;
    const text = [
      `お名前: ${sentContent.name}`,
      `メールアドレス: ${sentContent.email}`,
      'お問い合わせ内容:',
      sentContent.message,
    ].join('\n');
    try {
      await navigator.clipboard.writeText(text);
      copyStatus.textContent = 'コピーしました。';
      copyStatus.className = 'text-center text-xs text-accent-text';
    } catch {
      copyStatus.textContent = 'コピーできませんでした。お手数ですが、上の内容を選択してコピーしてください。';
      copyStatus.className = 'text-center text-xs text-red-600';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !status) return;

    const data = Object.fromEntries(new FormData(form).entries());

    // ハニーポットに値が入っていたらスパムとみなし、成功したように見せて何もしない
    if (data.company) {
      status.textContent = '送信しました。ありがとうございます。';
      status.className = 'text-sm text-accent-text';
      form.reset();
      return;
    }

    // Turnstileウィジェットがある場合、認証トークンを取得できているか送信時に確認する
    // (ボタンを常時無効化する方式だと、トークン更新が間に合わず固まって見えるため)
    const turnstileToken = (data['cf-turnstile-response'] as string) ?? '';
    if (turnstileWidget && !turnstileToken) {
      showError('認証を確認できませんでした。数秒待ってからもう一度お試しください。');
      return;
    }

    submitBtn?.setAttribute('disabled', 'true');
    // 見た目はボタンの表示で伝えるため、文言はスクリーンリーダー向けにだけ読み上げる
    status.textContent = '送信中です…';
    status.className = 'sr-only';

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: data.name,
          email: data.email,
          message: data.message,
          privacyConsent: data.privacyConsent === 'on',
          loadedAt: data.loadedAt,
          turnstileToken,
        }),
      });

      const body = (await res.json().catch(() => ({}))) as {
        error?: string;
        fallbackEmail?: string;
      };
      if (res.ok) {
        status.textContent = '';
        showComplete(
          {
            name: String(data.name ?? '').trim(),
            email: String(data.email ?? '').trim(),
            message: String(data.message ?? '').trim(),
          },
          body.fallbackEmail
        );
        form.reset();
        updateMessageCount();
      } else {
        if (body.error === 'turnstile_missing' || body.error === 'turnstile_failed') {
          showError('認証に失敗しました。もう一度お試しください。');
        } else if (body.error === 'invalid_email') {
          showError('メールアドレスの形式をご確認ください。');
        } else if (body.error === 'missing_fields') {
          showError('未入力の項目があります。ご確認ください。');
        } else if (body.error === 'name_too_long') {
          showError(`お名前は${CONTACT_LIMITS.name}文字以内でご入力ください。`);
        } else if (body.error === 'message_too_long') {
          showError(`お問い合わせ内容は${CONTACT_LIMITS.message}文字以内でご入力ください。`);
        } else if (body.error === 'rate_limited') {
          showError('短時間に続けて送信されたため、受け付けを一時停止しています。1分ほど待ってから再度お試しください。');
        } else if (body.error === 'privacy_consent_required') {
          showError('プライバシーポリシーへの同意が必要です。');
        } else if (body.error === 'server_error' && body.fallbackEmail) {
          showError(
            `送信に失敗しました。時間をおいて再度お試しいただき、それでも解決しない場合は ${body.fallbackEmail} までご連絡ください。`
          );
        } else if (body.error === 'server_error') {
          showError('送信に失敗しました。時間をおいて再度お試しください。');
        } else {
          showError('送信に失敗しました。時間をおいて再度お試しください。');
        }
      }
    } catch {
      showError('送信に失敗しました。通信環境をご確認のうえ再度お試しください。');
    } finally {
      // Turnstileのトークンは1回のみ有効なため、次回送信に備えてウィジェットをリセットする
      (window as any).turnstile?.reset();
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
