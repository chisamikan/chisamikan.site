---
import type { WorkItem } from '../lib/notion';
import WorkThumbnail from './WorkThumbnail.astro';

interface Props {
  item: WorkItem;
}
const { item } = Astro.props;

function formatPeriod(start: string | null, end: string | null) {
  const fmt = (d: string) =>
    new Date(d).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit' });
  if (!start) return '';
  return end ? `${fmt(start)} - ${fmt(end)}` : `${fmt(start)} -`;
}
---

<article class="glass-card group flex h-full flex-col overflow-hidden rounded-2xl border border-white/40 bg-white/25 shadow-glass backdrop-blur-xl hover:border-white/60 hover:shadow-glass-lg">
  <WorkThumbnail item={item} class="w-full" bare />

  <div class="flex flex-1 flex-col border-t border-white/30 p-4">
    <p class="font-mono text-xs text-graphite">{formatPeriod(item.periodStart, item.periodEnd)}</p>
    <h3 class="mt-1 font-display text-lg font-semibold text-ink">{item.client}</h3>
    {item.role && <p class="mt-0.5 text-sm font-medium text-accent">{item.role}</p>}

    {item.tags.length > 0 && (
      <ul class="mt-auto flex flex-wrap gap-1.5 pt-3">
        {item.tags.map((tag) => (
          <li class="rounded-full border border-ink/10 bg-white/40 px-2.5 py-0.5 font-mono text-[11px] text-ink/70 backdrop-blur-sm">
            {tag}
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
