---
import type { WorkItem } from '../lib/notion';
import WorkThumbnail from './WorkThumbnail.astro';

interface Props {
  item: WorkItem;
}
const { item } = Astro.props;

function formatPeriod(start: string | null, end: string | null) {
  const fmt = (d: string) =>
    new Date(d).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit' });
  if (!start) return '';
  return end ? `${fmt(start)} - ${fmt(end)}` : `${fmt(start)} -`;
}
---

<article class="flex flex-col gap-4">
  <WorkThumbnail item={item} class="paper-tilt w-full" />

  <div>
    <p class="font-mono text-xs text-graphite">{formatPeriod(item.periodStart, item.periodEnd)}</p>
    <h3 class="mt-1 font-display text-lg font-semibold text-ink">{item.client}</h3>
    {item.role && <p class="mt-0.5 text-sm font-medium text-indigo">{item.role}</p>}

    {item.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {item.tags.map((tag) => (
          <li class="rounded-full border border-ink/15 px-2.5 py-0.5 font-mono text-[11px] text-ink/70">
            {tag}
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
