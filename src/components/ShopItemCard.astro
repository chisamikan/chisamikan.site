---
import type { BoothItem } from '../lib/booth';

interface Props {
  item: BoothItem;
  headingLevel?: 2 | 3;
}
const { item, headingLevel = 3 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
const PLACEHOLDER = '/images/work-placeholder.svg';
---

<article class="glass-card glass-panel group flex h-full flex-col overflow-hidden">
  <a
    href={item.url}
    target="_blank"
    rel="noopener noreferrer"
    class="no-external-icon block aspect-square w-full overflow-hidden bg-paper-dim"
    aria-label={`${item.title}をBOOTHで見る`}
  >
    {item.imageUrl ? (
      <img
        src={item.imageUrl}
        alt={item.title}
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
      />
    ) : (
      <img src={PLACEHOLDER} alt="" loading="lazy" class="h-full w-full object-cover" />
    )}
  </a>
  <div class="glass-card-body">
    <Tag class="line-clamp-2 font-display text-base font-medium leading-snug text-ink">
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="transition-colors hover:text-accent"
      >
        {item.title}
      </a>
    </Tag>
    {item.category && (
      <ul class="mt-2 flex flex-wrap gap-1.5">
        <li class="glass-tag">{item.category}</li>
      </ul>
    )}
    <p class="mt-auto pt-3 font-mono text-sm text-accent">{item.price}</p>
  </div>
</article>
