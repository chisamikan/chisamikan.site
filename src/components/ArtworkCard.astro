---
import type { ArtworkItem } from '../lib/notion';

interface Props {
  item: ArtworkItem;
  headingLevel?: 2 | 3;
}
const { item, headingLevel = 3 } = Astro.props;
const Tag = `h${headingLevel}` as 'h2' | 'h3';
const hasImage = Boolean(item.imageUrl);
---

<figure class="glass-card group flex h-full flex-col overflow-hidden rounded-2xl border border-white/40 bg-white/25 shadow-glass backdrop-blur-xl hover:border-white/60 hover:shadow-glass-lg">
  {hasImage ? (
    <button
      type="button"
      class="lightbox-trigger relative block aspect-square w-full overflow-hidden bg-paper-dim"
      data-full={item.imageUrl}
      data-alt={item.title}
      aria-label={item.nsfw ? `${item.title}(NSFW)を拡大表示` : `${item.title}を拡大表示`}
    >
      <img
        src={item.imageUrl}
        alt={item.title}
        loading="lazy"
        class:list={[
          'h-full w-full object-cover transition-transform duration-500 group-hover:scale-105',
          item.nsfw && 'scale-110 blur-xl',
        ]}
      />
      {item.nsfw && (
        <span class="absolute inset-0 flex items-center justify-center bg-ink/35">
          <span class="rounded-full bg-ink/85 px-3 py-1 font-mono text-xs uppercase tracking-widest text-paper">
            NSFW
          </span>
        </span>
      )}
    </button>
  ) : (
    <div class="flex aspect-square w-full cursor-default items-center justify-center bg-paper-dim text-graphite" aria-hidden="true">
      <span class="font-mono text-xs">No Image</span>
    </div>
  )}
  <figcaption class="flex flex-1 flex-col border-t border-white/30 p-4">
    <Tag class="font-display text-lg font-medium leading-snug text-ink">{item.title}</Tag>
    {item.description && (
      <p class="mt-1 line-clamp-2 text-sm text-ink/70">{item.description}</p>
    )}
    <div class="mt-auto pt-3">
      {item.tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {item.tags.map((tag) => (
            <li class="rounded-full border border-ink/10 bg-white/40 px-2.5 py-0.5 font-mono text-[11px] text-ink/70 backdrop-blur-sm">
              {tag}
            </li>
          ))}
        </ul>
      )}
      {item.date && (
        <p class="mt-2 font-mono text-[11px] text-graphite">
          {new Date(item.date).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
        </p>
      )}
    </div>
  </figcaption>
</figure>
