---
import type { ArtworkItem } from '../lib/notion';

interface Props {
  item: ArtworkItem;
  tilt?: '1.5' | '-1.5' | '2.5' | '-2.5' | '0';
}
const { item, tilt = '0' } = Astro.props;
const tiltClass =
  tilt === '0'
    ? ''
    : {
        '1.5': 'rotate-1.5',
        '-1.5': '-rotate-1.5',
        '2.5': 'rotate-2.5',
        '-2.5': '-rotate-2.5',
      }[tilt];
const hasImage = Boolean(item.imageUrl);
---

<figure class:list={['paper-tilt group overflow-hidden rounded-sm bg-white shadow-pin', tiltClass]}>
  {hasImage ? (
    <button
      type="button"
      class="lightbox-trigger relative block aspect-[4/5] w-full overflow-hidden bg-paper-dim"
      data-full={item.imageUrl}
      data-alt={item.title}
      aria-label={item.nsfw ? `${item.title}(NSFW)を拡大表示` : `${item.title}を拡大表示`}
    >
      <img
        src={item.imageUrl}
        alt={item.title}
        loading="lazy"
        class:list={[
          'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105',
          item.nsfw && 'scale-110 blur-xl',
        ]}
      />
      {item.nsfw && (
        <span class="absolute inset-0 flex items-center justify-center bg-ink/35">
          <span class="rounded-full bg-ink/85 px-3 py-1 font-mono text-xs uppercase tracking-widest text-paper">
            NSFW
          </span>
        </span>
      )}
    </button>
  ) : (
    <div class="flex aspect-[4/5] w-full cursor-default items-center justify-center bg-paper-dim text-graphite" aria-hidden="true">
      <span class="font-mono text-xs">No Image</span>
    </div>
  )}
  <figcaption class="border-t border-ink/10 p-4">
    <h3 class="font-display text-lg font-medium leading-snug text-ink">{item.title}</h3>
    {item.description && (
      <p class="mt-1 line-clamp-2 text-sm text-ink/70">{item.description}</p>
    )}
    {item.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {item.tags.map((tag) => (
          <li class="rounded-full border border-ink/15 px-2.5 py-0.5 font-mono text-[11px] text-ink/70">
            {tag}
          </li>
        ))}
      </ul>
    )}
    {item.date && (
      <p class="mt-2 font-mono text-[11px] text-graphite">
        {new Date(item.date).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' })}
      </p>
    )}
  </figcaption>
</figure>
