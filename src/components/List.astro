---
import type { WorkItem, NovelItem, ToolboxItem } from '../lib/notion';
import Thumbnail from './Thumbnail.astro';

type Props =
  | { type: 'work'; item: WorkItem; headingLevel?: 2 | 3 }
  | { type: 'novel'; item: NovelItem; headingLevel?: 2 | 3 }
  | { type: 'toolbox'; item: ToolboxItem; headingLevel?: 2 | 3 };

const props = Astro.props;
const Tag = `h${props.headingLevel ?? 3}` as 'h2' | 'h3';

// novels.astro のギャラリーからの「/novels#novel-{id}」深リンク先として使うスクロールアンカー
const id = props.type === 'novel' ? `novel-${props.item.id}` : undefined;
const entryClass = props.type === 'novel' ? 'scroll-mt-24' : undefined;

function formatPeriod(start: string | null, end: string | null) {
  const fmt = (d: string) =>
    new Date(d).toLocaleDateString('ja-JP', { year: 'numeric', month: '2-digit' });
  if (!start) return '';
  return end ? `${fmt(start)} - ${fmt(end)}` : `${fmt(start)} -`;
}
---

<article id={id} class:list={['py-6', entryClass]}>
  <div class="flex items-start gap-5">
    {props.type === 'work' && (
      <Thumbnail
        imageUrl={props.item.imageUrl}
        label={`${props.item.client}の画像`}
        class="w-20 shrink-0 sm:w-36"
      />
    )}
    {props.type === 'novel' && (
      <Thumbnail
        imageUrl={props.item.imageUrl}
        label={`${props.item.title}の表紙`}
        class="w-20 shrink-0 sm:w-36"
      />
    )}
    {props.type === 'toolbox' && (
      <Thumbnail
        imageUrl={props.item.imageUrl}
        label={`${props.item.title}の画像`}
        class="w-20 shrink-0 sm:w-36"
      />
    )}

    <div class="min-w-0 flex-1">
      {props.type === 'work' && (
        <>
          <p class="font-mono text-xs text-graphite">{formatPeriod(props.item.periodStart, props.item.periodEnd)}</p>
          <Tag class="mt-1 font-display text-xl font-semibold text-ink">{props.item.client}</Tag>
          {props.item.role && <p class="mt-0.5 text-sm font-medium text-accent">{props.item.role}</p>}

          {props.item.tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5">
              {props.item.tags.map((tag) => (
                <li class="glass-tag">
                  {tag}
                </li>
              ))}
            </ul>
          )}

          {props.item.url && (
            <a
              href={props.item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-glass btn-glass-sm mt-4 hover:text-accent"
            >
              詳細を見る
            </a>
          )}
        </>
      )}

      {props.type === 'novel' && (
        <>
          {props.item.tags.length > 0 && (
            <ul class="flex flex-wrap gap-1.5">
              {props.item.tags.map((tag) => (
                <li class="glass-tag">
                  {tag}
                </li>
              ))}
            </ul>
          )}

          <Tag class:list={['font-display text-xl font-semibold text-ink', props.item.tags.length > 0 && 'mt-2']}>
            {props.item.title}
          </Tag>
          {props.item.description && (
            <p class="mt-1 whitespace-pre-line text-sm text-ink/70">{props.item.description}</p>
          )}

          {(props.item.kakuyomuUrl || props.item.pixivUrl || props.item.shopUrl) && (
            <div class="mt-4 flex flex-wrap gap-2">
              {props.item.kakuyomuUrl && (
                <a
                  href={props.item.kakuyomuUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-glass btn-glass-sm hover:text-accent"
                >
                  カクヨムで読む
                </a>
              )}
              {props.item.pixivUrl && (
                <a
                  href={props.item.pixivUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-glass btn-glass-sm hover:text-accent"
                >
                  pixivで読む
                </a>
              )}
              {props.item.shopUrl && (
                <a
                  href={props.item.shopUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-glass btn-glass-sm hover:text-accent"
                >
                  通販はこちら
                </a>
              )}
            </div>
          )}
        </>
      )}

      {props.type === 'toolbox' && (
        <>
          <Tag class="font-display text-xl font-semibold text-ink">{props.item.title}</Tag>
          {props.item.description && <p class="mt-1 text-sm text-ink/70">{props.item.description}</p>}

          {props.item.url && (
            <a
              href={props.item.url}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-glass btn-glass-sm mt-4 hover:text-accent"
            >
              配布先
            </a>
          )}
        </>
      )}
    </div>
  </div>
</article>
