---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageLoader from '../components/PageLoader.astro';
import signaturePathUrl from '../assets/loader-signature-path.txt?url';
import BackgroundDecor from '../components/BackgroundDecor.astro';
import '../styles/global.css';
import { site, person, snsLinks } from '../lib/config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const ogImageURL = new URL('/og-image.webp', Astro.site ?? Astro.url).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const siteURL = new URL('/', Astro.site ?? Astro.url).toString();
const profileURL = new URL('/profile', Astro.site ?? Astro.url).toString();
const personImageURL = new URL(person.image, Astro.site ?? Astro.url).toString();

// サイト運営者(千紗みかん)とサイト自体を表す構造化データ。全ページ共通で埋め込む
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteURL}#website`,
      url: siteURL,
      name: site.title,
      description: site.description,
      inLanguage: 'ja',
      publisher: { '@id': `${siteURL}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteURL}#person`,
      name: person.name,
      alternateName: person.alternateName,
      url: profileURL,
      image: personImageURL,
      jobTitle: person.jobTitle,
      description: person.description,
      sameAs: snsLinks.map((link) => link.href),
    },
  ],
};
---

<!doctype html>
<html lang="ja" class="no-js">
  <head>
    <!-- 文字コードの宣言はHTMLの先頭1024バイト以内に置く必要があるため、headの最初に書く -->
    <meta charset="UTF-8" />
    <!-- スマホのブラウザの上部バー等の色。サイト内のテーマ切り替えにも追従させるため、
      media属性で端末設定に任せず、直後のスクリプトとHeader.astroのapplyStateで値を書き換える -->
    <meta name="theme-color" content="#e8f0fa" />
    <script is:inline>
      // 初回描画前にテーマを確定させ、ちらつき(FOUC)を防ぐ。
      // 明示的な保存済み設定(localStorage)があればそれを優先し、無ければ端末の設定(prefers-color-scheme)に従う。
      (function () {
        var stored = localStorage.getItem('theme');
        var isDark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
        // global.cssの --color-paper(ライト/ダーク)と同じ色
        document.querySelector('meta[name="theme-color"]').setAttribute('content', isDark ? '#0b0e1a' : '#e8f0fa');
      })();
      // 読み込み画面(PageLoader)はセッション中の初回表示だけ見せる。2ページ目以降は
      // 描画前に印を付けて最初から出さない(印の保存はPageLoader側で行う)。
      (function () {
        try {
          if (sessionStorage.getItem('chisamikan-page-loader-shown')) {
            document.documentElement.classList.add('skip-page-loader');
          }
        } catch (e) {
          // sessionStorageが使えない場合は毎回表示するが、閲覧には支障がない
        }
      })();
      // ページ間のビュートランジション(global.cssの@view-transition)で開いたページでは、その終了を待てるようにする。
      // pagereveal は最初の描画の直前に発火し、本文末尾のスクリプトより先になることがあるため、ここで受け取っておく
      // (BaseLayout末尾の見出し等の演出の開始で使う)
      if ('onpagereveal' in window) {
        window.__pageRevealed = new Promise((r) => addEventListener('pagereveal', (e) => r(e.viewTransition && e.viewTransition.finished), { once: true }));
      }
    </script>
    <!-- 読み込み画面を出すときは、サインの文字の形(PageLoader)をここで高い優先度で取得し始める。
      HTMLを読み終えてから取得すると、遅い回線では画像やフォントと回線を取り合い、読み込み画面が消えるまでに間に合わない -->
    <script is:inline define:vars={{ signaturePathUrl }}>
      if (!document.documentElement.classList.contains('skip-page-loader')) {
        window.__loaderSignature = fetch(signaturePathUrl, { priority: 'high' }).then((res) => res.text());
      }
    </script>
    <!-- is:inline が無いとAstroが type="module" にしてHTMLを読み終えるまで実行を遅らせるため、
      HTMLの大きいページ(ギャラリー等)では、見出し等がJS無効時の表示済みの状態で出たあと、no-jsが外れた瞬間に隠れる状態へ動いてしまう -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${site.title} - お知らせ`} href="/rss.xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
        rel="stylesheet"
      />
      <!-- 読み込み画面(PageLoader)はJSで消すため、JSが無効な環境では最初から出さない。
        is:inline が無いとAstroがstyleを<head>へ移してnoscriptの外に出し、常に非表示になってしまう -->
      <style is:inline>#page-loader { display: none; }</style>
    </noscript>

    <script>
      declare global {
        interface Window {
          dataLayer: unknown[];
          __pageRevealed?: Promise<unknown>;
        }
      }

      window.dataLayer = window.dataLayer || [];

      // gtag.js は配列ではなく arguments オブジェクトのみをコマンドとして扱うため、
      // 残余引数(...args)を push すると計測が行われない
      function gtag(..._args: unknown[]) {
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-XZSD8BQ5DE');

      // gtag.js(約170KB)は、最初の表示に必要な読み込みと回線・CPUを取り合わないよう、ページの読み込み後に読み込む。
      // それまでの gtag() の呼び出しは dataLayer に溜まり、読み込まれた時点でまとめて送信される。
      // append ではなく appendChild を使う(tsconfigのCloudflare Workersの型がElement.appendをHTMLRewriter用の型で上書きしており、型エラーになるため)
      window.addEventListener('load', () =>
        document.head.appendChild(Object.assign(document.createElement('script'), { src: 'https://www.googletagmanager.com/gtag/js?id=G-XZSD8BQ5DE' })),
      );
    </script>
	
  </head>
  <body>
    <!-- キーボード操作時に、毎ページのナビを飛ばして本文へ移動できるようにする。
      普段は隠し、Tabキーでフォーカスしたときだけ左上に表示する -->
    <a
      href="#main"
      class="sr-only rounded-full bg-accent-strong px-4 py-2 text-sm font-medium text-on-accent focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-110"
    >
      本文へスキップ
    </a>
    <PageLoader />
    <BackgroundDecor />
    <Header />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal, .card-reveal, .heading-reveal, .hero-reveal');

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -10% 0px' },
      );
      const startReveal = () => revealEls.forEach((el) => observer.observe(el));

      // 読み込み画面(PageLoader)が出ている間に始めると、画面に入っている見出し等の演出が
      // その下で終わってしまうため、読み込み画面が消え始めてから監視を始める
      const loader = document.getElementById('page-loader');
      const loaderShown =
        loader && !loader.classList.contains('is-hidden') && getComputedStyle(loader).display !== 'none';
      if (loaderShown) {
        new MutationObserver((_, mo) => {
          if (!loader.classList.contains('is-hidden')) return;
          mo.disconnect();
          startReveal();
        }).observe(loader, { attributes: true, attributeFilter: ['class'] });
        // 読み込み画面のスクリプトが動かず is-hidden が付かない場合(CSSの10秒の安全策で消える)に備える
        window.setTimeout(startReveal, 10000);
      } else {
        // 読み込み画面を出さない2ページ目以降は、ページ間のビュートランジションの最中に始めると、
        // iOS Safariで見出し等の演出がトランジションの終了時にもう一度再生されるため、終わってから始める
        (window.__pageRevealed || Promise.resolve()).then(startReveal);
      }
    </script>
  </body>
</html>
