# 本番での設定場所(ビルド用/実行時用)は wrangler.toml 末尾のコメントを参照。

# --- Notion ---
# Notion Integration を作成し、対象のページ/データベースに接続(Share)してから発行したトークン
# https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ギャラリー用データベースの Database ID
NOTION_GALLERY_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 小説用データベースの Database ID
NOTION_NOVELS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 仕事履歴用データベースの Database ID
NOTION_WORKS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ツールボックス用データベースの Database ID
NOTION_TOOLBOX_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# おみくじ用データベースの Database ID (404ページで使用)
NOTION_OMIKUJI_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# お知らせ(手動投稿)用データベースの Database ID
NOTION_NEWS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- お知らせ(外部ブログ RSS) ---
RSS_FEED_URL=https://example.com/blog/feed

# --- ショップ(BOOTH) ---
# ショップのURL(末尾の /items から新着商品一覧を取得します)
BOOTH_SHOP_URL=https://your-shop.booth.pm

# --- お問い合わせフォームのスパム対策(Cloudflare Turnstile) ---
# https://dash.cloudflare.com/ > Turnstile で新しいサイトを追加して発行
# 本番では TURNSTILE_SECRET_KEY が未設定だとお問い合わせの送信がエラーになります(設定漏れ防止)。
# ローカル開発(astro dev)では未設定でも動作し、その場合Turnstileによる検証は行われません
# (ハニーポット・タイムトラップは常に有効です)
TURNSTILE_SITE_KEY=0x4xxxxxxxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4xxxxxxxxxxxxxxxxxxxx

# --- お問い合わせ通知 ---
# お問い合わせ内容は、wrangler.toml の CONTACT_EMAIL(Cloudflare Email Routing)で管理者宛にメール送信します。
# 送り先のアドレス。Email Routing の「宛先アドレス」で認証済みのものを指定する(未設定だと送信はエラーになります)
CONTACT_ADMIN_EMAIL=you@example.com

# 予備の連絡先。Email Routing の「カスタムアドレス」で作った転送用アドレスを指定する。
# 公開ページには載せず、送信完了画面・送信失敗時の案内にだけ表示する(未設定なら案内しない)。
# 迷惑メールが届くようになったら、Email Routingで別のアドレスを作ってここを差し替える
CONTACT_FALLBACK_EMAIL=support@example.com

# Discordには新着・送信失敗の定型文のみを送ります(個人情報は含めません)。
# Discordの「連携サービス」>「Webhookを作成」で発行したURL(未設定なら通知しません)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx
